diff --git a/dist/install.dos b/dist/install.dos
index 1ba1106..b6caf15 100644
--- a/dist/install.dos
+++ b/dist/install.dos
@@ -301,6 +301,19 @@ Lab copy-coreutils
 ; keeps its own commands.
 MakeDir >NIL: UP-Term:bin
 Copy coreutils/bin UP-Term:bin ALL CLONE QUIET
+; The Unix tool ports (upterm-ports): grep, sed, awk, less, nano, diff, cmp,
+; diff3, sdiff, patch, man and ncurses' tput, reset, clear... beside coreutils;
+; their pages in UP-Term:share/man (man's default MANPATH, /UP-Term/share/man),
+; nano's syntax files and its system nanorc (UP-Term:etc/nanorc), and every
+; package's licence in UP-Term:licenses. SOURCES.txt there names each one's
+; version and upstream archive; the complete source with UP-Term's patches
+; and build recipes is UP-Term-src.lha, published next to UP-Term.lha.
+Copy userland/bin UP-Term:bin ALL CLONE QUIET
+MakeDir >NIL: UP-Term:share UP-Term:etc UP-Term:licenses
+Copy userland/share UP-Term:share ALL CLONE QUIET
+Copy userland/etc UP-Term:etc ALL CLONE QUIET
+Copy userland/licenses UP-Term:licenses ALL CLONE QUIET
+Copy userland/SOURCES.txt UP-Term:licenses/SOURCES.txt CLONE QUIET
 If NOT "{STEP}" EQ ""
   Quit 0
 EndIf
