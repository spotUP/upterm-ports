From d4547939676d239dfbf3362a791af2f85b45dc23 Mon Sep 17 00:00:00 2001
From: spotUP <retroranksmail@gmail.com>
Date: Thu, 15 Oct 2026 22:57:02 +0200
Subject: [PATCH] job.c: no confstr (_CS_PATH) in ixemul, use a fixed default
 PATH

---
 src/job.c | 9 ++-------
 1 file changed, 2 insertions(+), 7 deletions(-)

diff --git a/src/job.c b/src/job.c
index ea88561..d7efde5 100644
--- a/src/job.c
+++ b/src/job.c
@@ -2430,13 +2430,8 @@ child_execute_job (struct childbase *child, int good_stdin, char **argv)
     /* execvp() will use a default PATH if none is set; emulate that.  */
     if (p == NULL)
       {
-        size_t l = confstr (_CS_PATH, NULL, 0);
-        if (l)
-          {
-            char *dp = alloca (l);
-            confstr (_CS_PATH, dp, l);
-            p = dp;
-          }
+        /* ixemul declares confstr() but has neither it nor _CS_PATH.  */
+        p = (char *)"/bin:/usr/bin";
       }
 
     cmd = (char *)find_in_given_path (argv[0], p, NULL, 0);
-- 
