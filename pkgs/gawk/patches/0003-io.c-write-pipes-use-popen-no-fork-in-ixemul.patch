From 4e7e9f392ff80f59bb35197a4a1f36453b264ca8 Mon Sep 17 00:00:00 2001
From: spotUP <retroranksmail@gmail.com>
Date: Thu, 15 Oct 2026 23:17:04 +0200
Subject: [PATCH 3/5] io.c: write pipes use popen, no fork in ixemul

---
 io.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/io.c b/io.c
index f1c962d..dae7c42 100644
--- a/io.c
+++ b/io.c
@@ -4617,7 +4617,7 @@ static write_pipe *open_pipes = NULL;
 static FILE *
 gawk_popen_write(const char *cmd)
 {
-#if defined(VMS) || defined(__MINGW32__)
+#if 1 /* ixemul: no fork, popen is vfork + /bin/sh */
 	return popen(cmd, binmode("w"));
 #else
 	pid_t childpid;
@@ -4670,7 +4670,7 @@ gawk_popen_write(const char *cmd)
 static int
 gawk_popen_write_close(FILE *fp)
 {
-#if defined(VMS) || defined(__MINGW32__)
+#if 1 /* ixemul: no fork, popen is vfork + /bin/sh */
 	return pclose(fp);
 #else
 	int status, index;
-- 
