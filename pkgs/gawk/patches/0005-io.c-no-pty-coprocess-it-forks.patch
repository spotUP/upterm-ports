From: spotUP <retroranksmail@gmail.com>
Date: Thu, 15 Oct 2026 23:23:41 +0200
Subject: [PATCH 5/5] io.c: no pty coprocess, it forks

---
 io.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/io.c b/io.c
index dae7c42..24bbd3e 100644
--- a/io.c
+++ b/io.c
@@ -1964,7 +1964,7 @@ strictopen:
 	return openfd;
 }
 
-#if defined(HAVE_TERMIOS_H)
+#if 0 /* ixemul: no fork, no pty coprocess (|&) */
 /* push_pty_line_disciplines --- push line disciplines if we work that way */
 
 // Factors out common code for the two versions of fork_and_open_slave_pty().
@@ -2213,7 +2213,7 @@ two_way_open(const char *str, struct redirect *rp, int extfd)
 	if (find_two_way_processor(str, rp))
 		return true;
 
-#if defined(HAVE_TERMIOS_H)
+#if 0 /* ixemul: no fork, no pty coprocess (|&) */
 	/* case 3: use ptys for two-way communications to child */
 	if (! no_ptys && pty_vs_pipe(str)) {
 		static bool initialized = false;
