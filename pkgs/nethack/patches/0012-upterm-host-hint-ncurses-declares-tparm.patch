From: spotUP <retroranksmail@gmail.com>
Date: Fri, 23 Oct 2026 17:40:25 +0200
Subject: [PATCH 12/12] upterm-host hint: ncurses declares tparm

---
 sys/unix/hints/upterm-host | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/sys/unix/hints/upterm-host b/sys/unix/hints/upterm-host
index 5ff8173..86af926 100644
--- a/sys/unix/hints/upterm-host
+++ b/sys/unix/hints/upterm-host
@@ -11,7 +11,7 @@ VARDIR=$(HACKDIR)
 POSTINSTALL=
 # the system headers use __has_attribute(warn_unused_result), which tradstdc.h defines empty: include them first
 CFLAGS=-O -include sys/cdefs.h -include stdio.h -include stdlib.h -include string.h -I../include -I$(NH_INC) -I$(NH_INC)/ncursesw  -Wno-everything
-CFLAGS+=-DDLB -DNOSHELL -DHACKDIR=\"$(HACKDIR)\" -DDUMPLOG -DCURSES_GRAPHICS
+CFLAGS+=-DNOTPARMDECL -DDLB -DNOSHELL -DHACKDIR=\"$(HACKDIR)\" -DDUMPLOG -DCURSES_GRAPHICS
 LINK=$(CC)
 LFLAGS=
 WINSRC = $(WINTTYSRC) $(WINCURSESSRC)
