From 34a70449993f9a29301a73013a2e0c33f0659f98 Mon Sep 17 00:00:00 2001
From: spotUP <x@y>
Date: Fri, 23 Oct 2026 17:30:16 +0200
Subject: [PATCH 9/9] m68k hints: no save file compression (it forks
 /usr/bin/compress; ixemul has no fork)

---
 include/config.h            | 2 +-
 sys/unix/hints/m68k-amigaos | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/include/config.h b/include/config.h
index b606b5d..aec66b7 100644
--- a/include/config.h
+++ b/include/config.h
@@ -261,7 +261,7 @@
  *
  */
 
-#if defined(UNIX) && !defined(ZLIB_COMP) && !defined(COMPRESS)
+#if defined(UNIX) && !defined(ZLIB_COMP) && !defined(COMPRESS) && !defined(NO_COMPRESS)
 /* path and file name extension for compression program */
 #define COMPRESS "/usr/bin/compress" /* Lempel-Ziv compression */
 #define COMPRESS_EXTENSION ".Z"      /* compress's extension */
diff --git a/sys/unix/hints/m68k-amigaos b/sys/unix/hints/m68k-amigaos
index 791da42..398be12 100644
--- a/sys/unix/hints/m68k-amigaos
+++ b/sys/unix/hints/m68k-amigaos
@@ -18,7 +18,7 @@ AR=$(NH_AR)
 RANLIB=$(NH_RANLIB)
 CFLAGS=$(NH_CFLAGS) -I../include -I$(NH_INC) -I$(NH_INC)/ncursesw -UAMIGA -UMCH_AMIGA -U__MCH_AMIGA__ -DNOTPARMDECL
 # bundled game data, no compression helper, no '!' shell (it forks), no fcntl record locking in ixemul (lock files instead)
-CFLAGS+=-DDLB -DNOSHELL -DNO_FCNTL_LOCKING -DNO_FILE_LINKS -DLOCKDIR=\"$(HACKDIR)\" -DHACKDIR=\"$(HACKDIR)\" -DDUMPLOG -DCURSES_GRAPHICS
+CFLAGS+=-DDLB -DNOSHELL -DNO_COMPRESS -DNO_FCNTL_LOCKING -DNO_FILE_LINKS -DLOCKDIR=\"$(HACKDIR)\" -DHACKDIR=\"$(HACKDIR)\" -DDUMPLOG -DCURSES_GRAPHICS
 LINK=$(CC)
 LFLAGS=
 WINSRC = $(WINTTYSRC) $(WINCURSESSRC)
-- 
