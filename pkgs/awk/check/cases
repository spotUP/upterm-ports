version	awk --version
sum	awk "{ s += \$2 } END { print s }" fruit.txt
printf	awk -f printf.awk fruit.txt
fs	awk -F: "{ print \$1, \$3 }" colon.txt
nr	awk "NR == 2 { print NR, NF, \$0 }" fruit.txt
pattern	awk "/an/ { print \$1 }" fruit.txt
var	awk -v x=10 "BEGIN { print x + 2 }"
math	awk -f math.awk
string	awk -f string.awk
system	awk -f system.awk
pipe-out	awk -f prog.awk fruit.txt
getline	awk -f getline.awk
stdin	awk "{ print \$1 }" < fruit.txt
missing	awk 1 nosuchfile
syntax	awk "BEGIN { print ( }"
quote-arg	awk "BEGIN { print \"quoted\", 2 * 3 }"
system-quote	awk -f sysquote.awk
