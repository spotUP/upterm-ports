version	iconv --version | sed -n 1p
roundtrip	iconv -f UTF-8 -t ISO-8859-1 l.txt | iconv -f ISO-8859-1 -t UTF-8
latin1-fail	iconv -f UTF-8 -t ISO-8859-1 u.txt > l2.txt; echo rc=$?
translit	iconv -f UTF-8 -t ASCII//TRANSLIT u.txt
discard	iconv -c -f UTF-8 -t ASCII u.txt
invalid	iconv -f UTF-8 -t ASCII u.txt; echo rc=$?
utf16	iconv -f UTF-8 -t UTF-16LE u.txt | iconv -f UTF-16LE -t UTF-8
list	iconv -l | sed -n 1p
redirect	iconv -f UTF-8 -t ISO-8859-1 l.txt > l1.txt; iconv -f ISO-8859-1 -t UTF-8 l1.txt
