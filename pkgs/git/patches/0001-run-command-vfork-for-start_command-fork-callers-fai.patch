From e9ee946886e89e57cf4f55f5f49c4b54f92caa67 Mon Sep 17 00:00:00 2001
From: upterm-ports <upterm-ports@localhost>
Date: Sat, 17 Oct 2026 11:18:56 +0200
Subject: [PATCH 1/3] run-command: vfork() for start_command; fork() callers
 fail cleanly under USE_VFORK

ixemul has vfork but no fork. The start_command child only execs, so vfork
suffices (signal dispositions and child_notifier are restored in the parent).
start_async, daemonize and the transport-helper copy loop need a continuing
child: they report an error, so no _fork is linked.
---
 run-command.c      | 42 +++++++++++++++++++++++++++++++++++++++++-
 setup.c            |  2 +-
 transport-helper.c |  3 +++
 3 files changed, 45 insertions(+), 2 deletions(-)

diff --git a/run-command.c b/run-command.c
index ce84db8..052b8d4 100644
--- a/run-command.c
+++ b/run-command.c
@@ -753,6 +753,10 @@ int start_command(struct child_process *cmd)
 	struct strvec argv = STRVEC_INIT;
 	struct child_err cerr;
 	struct atfork_state as;
+#ifdef USE_VFORK
+	struct sigaction vfork_sa[NSIG];
+	int vfork_notifier;
+#endif
 
 	if (prepare_cmd(&argv, cmd) < 0) {
 		failed_errno = errno;
@@ -784,10 +788,39 @@ int start_command(struct child_process *cmd)
 	 * never be released in the child process.  This means only
 	 * Async-Signal-Safe functions are permitted in the child.
 	 */
+#ifdef USE_VFORK
+	/*
+	 * No fork() on this platform (ixemul): vfork() shares the parent's
+	 * memory until the child execs or _exits. The child below only
+	 * dup2s/closes, resets signals and execs, so what it writes to
+	 * parent state is saved here and put back after vfork() returns:
+	 * the signal dispositions and child_notifier. The die/error/warn
+	 * routines are not switched in the child (they exist to avoid
+	 * locks after a threaded fork).
+	 */
+	{
+		int sig;
+		for (sig = 1; sig < NSIG; sig++)
+			if (sigaction(sig, NULL, &vfork_sa[sig]))
+				vfork_sa[sig].sa_handler = SIG_DFL;
+	}
+	vfork_notifier = child_notifier;
+	cmd->pid = vfork();
+	if (cmd->pid) {
+		int sig;
+		failed_errno = errno;
+		child_notifier = vfork_notifier;
+		for (sig = 1; sig < NSIG; sig++)
+			sigaction(sig, &vfork_sa[sig], NULL);
+		errno = failed_errno;
+	}
+#else
 	cmd->pid = fork();
+#endif
 	failed_errno = errno;
 	if (!cmd->pid) {
 		int sig;
+#ifndef USE_VFORK
 		/*
 		 * Ensure the default die/error/warn routines do not get
 		 * called, they can take stdio locks and malloc.
@@ -795,6 +828,7 @@ int start_command(struct child_process *cmd)
 		set_die_routine(child_die_fn);
 		set_error_routine(child_error_fn);
 		set_warn_routine(child_warn_fn);
+#endif
 
 		close(notify_pipe[0]);
 		set_cloexec(notify_pipe[1]);
@@ -1202,7 +1236,13 @@ int start_async(struct async *async)
 	else
 		proc_out = -1;
 
-#ifdef NO_PTHREADS
+#if defined(NO_PTHREADS) && defined(USE_VFORK)
+	/* The async body keeps running next to the parent: it needs fork(). */
+	error("git: asynchronous processes (sideband demultiplexing, "
+	      "clean/smudge filters) not supported on AmigaOS");
+	errno = ENOSYS;
+	goto error;
+#elif defined(NO_PTHREADS)
 	/* Flush stdio before fork() to avoid cloning buffers */
 	fflush(NULL);
 
diff --git a/setup.c b/setup.c
index 0d157ac..cb52562 100644
--- a/setup.c
+++ b/setup.c
@@ -2210,7 +2210,7 @@ void sanitize_stdfds(void)
 
 int daemonize(void)
 {
-#ifdef NO_POSIX_GOODIES
+#if defined(NO_POSIX_GOODIES) || defined(USE_VFORK)
 	errno = ENOSYS;
 	return -1;
 #else
diff --git a/transport-helper.c b/transport-helper.c
index d5a064d..f37050c 100644
--- a/transport-helper.c
+++ b/transport-helper.c
@@ -1620,6 +1620,9 @@ static int tloop_spawnwait_tasks(struct bidirectional_transfer_state *s)
 	pid_t pid1, pid2;
 	int ret = 0;
 
+#ifdef USE_VFORK
+	die(_("git: bidirectional transfer helpers not supported on AmigaOS"));
+#endif
 	/* Fork thread #1: git to program. */
 	pid1 = fork();
 	if (pid1 < 0)
-- 
2.50.1 (Apple Git-155)

