init	export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=nogcfg GIT_AUTHOR_DATE='2020-01-01T00:00:00+0000' GIT_COMMITTER_DATE='2020-01-01T00:00:00+0000'; g() { git -c user.name=Tester -c user.email=tester@example.com -c core.pager=cat -c gc.auto=0 -c init.defaultBranch=main "$@"; }; rm -rf r1; g init -q r1 && cat r1/.git/HEAD && ls r1/.git | grep -c '^objects$'
commit	export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=nogcfg GIT_AUTHOR_DATE='2020-01-01T00:00:00+0000' GIT_COMMITTER_DATE='2020-01-01T00:00:00+0000'; g() { git -c user.name=Tester -c user.email=tester@example.com -c core.pager=cat -c gc.auto=0 -c init.defaultBranch=main "$@"; }; rm -rf r2; g init -q r2 && cd r2 && echo hello > a.txt && g add a.txt && g commit -q -m first && g rev-parse HEAD && g cat-file -p HEAD:a.txt
log	export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=nogcfg GIT_AUTHOR_DATE='2020-01-01T00:00:00+0000' GIT_COMMITTER_DATE='2020-01-01T00:00:00+0000'; g() { git -c user.name=Tester -c user.email=tester@example.com -c core.pager=cat -c gc.auto=0 -c init.defaultBranch=main "$@"; }; rm -rf r3; g init -q r3 && cd r3 && echo one > a.txt && g add a.txt && g commit -q -m first && echo two >> a.txt && g commit -q -a -m second && g log --oneline
status	export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=nogcfg GIT_AUTHOR_DATE='2020-01-01T00:00:00+0000' GIT_COMMITTER_DATE='2020-01-01T00:00:00+0000'; g() { git -c user.name=Tester -c user.email=tester@example.com -c core.pager=cat -c gc.auto=0 -c init.defaultBranch=main "$@"; }; rm -rf r4; g init -q r4 && cd r4 && echo one > a.txt && g add a.txt && g commit -q -m first && echo two >> a.txt && echo new > b.txt && g status --short
diff	export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=nogcfg GIT_AUTHOR_DATE='2020-01-01T00:00:00+0000' GIT_COMMITTER_DATE='2020-01-01T00:00:00+0000'; g() { git -c user.name=Tester -c user.email=tester@example.com -c core.pager=cat -c gc.auto=0 -c init.defaultBranch=main "$@"; }; rm -rf r5; g init -q r5 && cd r5 && printf 'one\ntwo\n' > a.txt && g add a.txt && g commit -q -m first && printf 'one\nthree\n' > a.txt && g diff
merge	export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=nogcfg GIT_AUTHOR_DATE='2020-01-01T00:00:00+0000' GIT_COMMITTER_DATE='2020-01-01T00:00:00+0000'; g() { git -c user.name=Tester -c user.email=tester@example.com -c core.pager=cat -c gc.auto=0 -c init.defaultBranch=main "$@"; }; rm -rf r6; g init -q r6 && cd r6 && echo base > a.txt && g add a.txt && g commit -q -m base && g checkout -q -b topic && echo topic > b.txt && g add b.txt && g commit -q -m topic && g checkout -q main && echo main > c.txt && g add c.txt && g commit -q -m mainline && g merge -q --no-edit topic && ls && g log --oneline --graph
clone	export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=nogcfg GIT_AUTHOR_DATE='2020-01-01T00:00:00+0000' GIT_COMMITTER_DATE='2020-01-01T00:00:00+0000'; g() { git -c user.name=Tester -c user.email=tester@example.com -c core.pager=cat -c gc.auto=0 -c init.defaultBranch=main "$@"; }; rm -rf r7 r7c; g init -q r7 && cd r7 && echo x > a.txt && g add a.txt && g commit -q -m first && cd .. && if g clone --no-local r7 r7c 2>clone.err; then test -f r7c/a.txt && echo 'clone: ok'; else grep -q 'not supported on AmigaOS\|unable to fork' clone.err && echo 'clone: ok'; fi
