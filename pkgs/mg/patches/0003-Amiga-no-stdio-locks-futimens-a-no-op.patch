From 34906f1c3a15f1d54f9044620c8fb216cbbf8eb4 Mon Sep 17 00:00:00 2001
From: spotUP <retroranksmail@gmail.com>
Date: Thu, 15 Oct 2026 20:54:30 +0200
Subject: [PATCH 3/6] Amiga: no stdio locks; futimens a no-op

---
 lib/fparseln.c | 13 +++++++++---
 lib/futimens.c |  6 ++++++
 2 files changed, 16 insertions(+), 3 deletions(-)

diff --git a/lib/fparseln.c b/lib/fparseln.c
index 151887d..03a877e 100644
--- a/lib/fparseln.c
+++ b/lib/fparseln.c
@@ -24,6 +24,13 @@
  * THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
  */
 
+#ifdef __amigaos__
+#define MG_FLOCKFILE(fp) ((void)0)
+#define MG_FUNLOCKFILE(fp) ((void)0)
+#else
+#define MG_FLOCKFILE(fp) flockfile(fp)
+#define MG_FUNLOCKFILE(fp) funlockfile(fp)
+#endif
 #include <assert.h>
 #include <errno.h>
 #include <stdio.h>
@@ -100,7 +107,7 @@ fparseln(FILE *fp, size_t *size, size_t *lineno, const char str[3], int flags)
 	 */
 	nl  = '\n';
 
-	flockfile(fp);
+	MG_FLOCKFILE(fp);
 
 	while (cnt) {
 		cnt = 0;
@@ -147,7 +154,7 @@ fparseln(FILE *fp, size_t *size, size_t *lineno, const char str[3], int flags)
 		}
 
 		if ((cp = realloc(buf, len + s + 1)) == NULL) {
-			funlockfile(fp);
+			MG_FUNLOCKFILE(fp);
 			free(buf);
 			free(ptr);
 			return NULL;
@@ -159,7 +166,7 @@ fparseln(FILE *fp, size_t *size, size_t *lineno, const char str[3], int flags)
 		buf[len] = '\0';
 	}
 
-	funlockfile(fp);
+	MG_FUNLOCKFILE(fp);
 	free(ptr);
 
 	if ((flags & FPARSELN_UNESCALL) != 0 && esc && buf != NULL &&
diff --git a/lib/futimens.c b/lib/futimens.c
index 10d7f48..d9b4338 100644
--- a/lib/futimens.c
+++ b/lib/futimens.c
@@ -5,10 +5,16 @@
 int
 futimens(int fd, const struct timespec times[2])
 {
+#ifdef __amigaos__
+	/* ixemul has no futimes: the times of a copied backup stay as written */
+	(void)fd; (void)times;
+	return 0;
+#else
 	struct timeval timevals[2];
 
 	TIMESPEC_TO_TIMEVAL(&timevals[0], &times[0]);
 	TIMESPEC_TO_TIMEVAL(&timevals[1], &times[1]);
 
 	return futimes(fd, timevals);
+#endif
 }
