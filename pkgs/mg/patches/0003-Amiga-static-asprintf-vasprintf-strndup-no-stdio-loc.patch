diff --git a/lib/futimens.c b/lib/futimens.c
index 10d7f48..d9b4338 100644
--- a/lib/futimens.c
+++ b/lib/futimens.c
@@ -5,10 +5,16 @@
 int
 futimens(int fd, const struct timespec times[2])
 {
+#ifdef __amigaos__
+	/* ixemul has no futimes: the times of a copied backup stay as written */
+	(void)fd; (void)times;
+	return 0;
+#else
 	struct timeval timevals[2];
 
 	TIMESPEC_TO_TIMEVAL(&timevals[0], &times[0]);
 	TIMESPEC_TO_TIMEVAL(&timevals[1], &times[1]);
 
 	return futimes(fd, timevals);
+#endif
 }
diff --git a/src/def.h b/src/def.h
index 70f3b40..b41f682 100644
--- a/src/def.h
+++ b/src/def.h
@@ -121,6 +121,60 @@ int     futimens(int, const struct timespec[2]);
 #endif
 #endif
 
+#ifdef __amigaos__
+/*
+ * ixemul declares asprintf, vasprintf and strndup but its library has no
+ * code for them: static copies, renamed so they cannot clash.
+ */
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define vasprintf mg_vasprintf
+#define asprintf mg_asprintf
+#define strndup mg_strndup
+static int
+mg_vasprintf(char **ret, const char *fmt, va_list ap)
+{
+	va_list	 ap2;
+	int	 n;
+
+	va_copy(ap2, ap);
+	n = vsnprintf(NULL, 0, fmt, ap2);
+	va_end(ap2);
+	if (n < 0 || (*ret = malloc((size_t)n + 1)) == NULL) {
+		*ret = NULL;
+		return (-1);
+	}
+	return (vsnprintf(*ret, (size_t)n + 1, fmt, ap));
+}
+
+static int
+mg_asprintf(char **ret, const char *fmt, ...)
+{
+	va_list	 ap;
+	int	 n;
+
+	va_start(ap, fmt);
+	n = mg_vasprintf(ret, fmt, ap);
+	va_end(ap);
+	return (n);
+}
+
+static char *
+mg_strndup(const char *s, size_t max)
+{
+	size_t	 n = strnlen(s, max);
+	char	*p = malloc(n + 1);
+
+	if (p != NULL) {
+		memcpy(p, s, n);
+		p[n] = '\0';
+	}
+	return (p);
+}
+#endif
+
 #include	"chrdef.h"
 
 typedef int	(*PF)(int, int);	/* generally useful type */
