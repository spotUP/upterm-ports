# mandoc's configure runs its test programs, which a cross build cannot:
# every answer is given here. Measured 2026-10-08: each test-*.c compiled
# for m68k with libixcompat (an implicit declaration counts as missing)
# and run on rig 3 (ixemul-vtcon feature/ixemul-80); exit 0 = 1. nanosleep,
# putwchar (wchar): libixcompat, added for this build.
OSNAME="AmigaOS (UP-Term)"
PREFIX="/UP-Term"
MANDIR="/UP-Term/share/man"
MANPATH_BASE="/UP-Term/share/man"
MANPATH_DEFAULT="/UP-Term/share/man"
BINM_PAGER=less
UTF8_LOCALE=en_US.UTF-8
INSTALL_LIBMANDOC=0
BUILD_CGI=0
BUILD_CATMAN=0
HAVE_ATTRIBUTE=1
HAVE_CMSG=0
HAVE_DIRENT_NAMLEN=1
HAVE_ENDIAN=1
HAVE_SYS_ENDIAN=0
HAVE_EFTYPE=1
HAVE_ERR=1
HAVE_FTS=1
HAVE_FTS_COMPARE_CONST=0
HAVE_GETLINE=0
HAVE_GETSUBOPT=0
HAVE_ISBLANK=1
HAVE_LESS_T=1
HAVE_MKDTEMP=0
HAVE_MKSTEMPS=0
HAVE_NANOSLEEP=1
HAVE_NTOHL=1
HAVE_O_DIRECTORY=0
HAVE_OHASH=0
HAVE_PATH_MAX=1
HAVE_PLEDGE=0
HAVE_PROGNAME=0
HAVE_REALLOCARRAY=0
HAVE_RECALLOCARRAY=0
HAVE_RECVMSG=0
HAVE_REWB_BSD=1
HAVE_REWB_SYSV=0
HAVE_SANDBOX_INIT=0
HAVE_STRCASESTR=0
HAVE_STRINGLIST=0
HAVE_STRLCAT=0
HAVE_STRLCPY=0
HAVE_STRNDUP=0
HAVE_STRPTIME=0
HAVE_STRSEP=1
HAVE_STRTONUM=0
HAVE_VASPRINTF=0
HAVE_WCHAR=1
HAVE_WFLAG=1
HAVE_NOOP=1
