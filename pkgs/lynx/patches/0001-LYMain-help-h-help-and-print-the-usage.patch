From 3a14040f9f901111c30785eec45439b89c251922 Mon Sep 17 00:00:00 2001
From: spotUP <x@localhost>
Date: Fri, 23 Oct 2026 11:49:18 +0200
Subject: [PATCH] LYMain: --help, -h, help and ? print the usage

---
 src/LYMain.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/LYMain.c b/src/LYMain.c
index 667d9b0..9fe5413 100644
--- a/src/LYMain.c
+++ b/src/LYMain.c
@@ -1168,6 +1168,10 @@ int main(int argc,
      * Set up the argument list.
      */
     pgm = argv[0];
+    /* UP-Term: a lone --help, -h, help or ? prints the usage (same as -help) */
+    if (argc == 2 && (!strcmp(argv[1], "--help") || !strcmp(argv[1], "-h")
+		      || !strcmp(argv[1], "help") || !strcmp(argv[1], "?")))
+	print_help_and_exit();
 #ifdef USE_PROGRAM_DIR
     StrAllocCopy(program_dir, pgm);
     if ((cp = (char *) strrchr(program_dir, '\\')) != NULL) {
-- 
