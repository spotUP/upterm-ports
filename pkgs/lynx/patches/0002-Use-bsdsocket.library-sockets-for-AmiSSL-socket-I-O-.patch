From cc647100e2db0e309e9b1ba69ea8e1ed55a7dada Mon Sep 17 00:00:00 2001
From: spotUP <x@localhost>
Date: Wed, 28 Oct 2026 10:22:56 +0100
Subject: [PATCH 2/2] Use bsdsocket.library sockets for AmiSSL: socket I/O
 through bsdsocket, errno registered, socket 0 valid

AmiSSL's SSL_set_fd needs a bsdsocket.library socket, and ixemul's read/write/close/select do
not know one. With AMIGA_BSDSOCKET the NETCLOSE/NETWRITE/SOCKET_READ/IOCTL/select macros go through
bsdsocket, bsdsocket.library numbers sockets from 0, and its errno is registered at start (else a
non-blocking connect leaves errno at 0).
---
 WWW/Library/Implementation/HTTCP.c   |  7 ++++++-
 WWW/Library/Implementation/HTUtils.h |  4 ++++
 WWW/Library/Implementation/www_tcp.h | 20 ++++++++++++++++++++
 src/LYMain.c                         |  6 ++++++
 4 files changed, 36 insertions(+), 1 deletion(-)

diff --git a/WWW/Library/Implementation/HTTCP.c b/WWW/Library/Implementation/HTTCP.c
index d1ab2c0..6fa467b 100644
--- a/WWW/Library/Implementation/HTTCP.c
+++ b/WWW/Library/Implementation/HTTCP.c
@@ -2420,7 +2420,7 @@ int HTDoRead(int fildes,
 #endif
 #endif /* !NO_IOCTL */
 
-#if defined(UNIX) && !defined(__BEOS__)
+#if defined(UNIX) && !defined(__BEOS__) && !defined(AMIGA_BSDSOCKET)
     if (fildes == 0) {
 	/*
 	 * 0 can be a valid socket fd, but if it's a tty something must have
@@ -2432,7 +2432,12 @@ int HTDoRead(int fildes,
 	}
     } else
 #endif
+#ifdef AMIGA_BSDSOCKET
+    /* bsdsocket.library numbers its sockets from 0 */
+    if (fildes < 0) {
+#else
     if (fildes <= 0) {
+#endif
 	CTRACE((tfp, "HTDoRead - no file descriptor!\n"));
 	return -1;
     }
diff --git a/WWW/Library/Implementation/HTUtils.h b/WWW/Library/Implementation/HTUtils.h
index eef3599..74fa720 100644
--- a/WWW/Library/Implementation/HTUtils.h
+++ b/WWW/Library/Implementation/HTUtils.h
@@ -16,6 +16,10 @@
 
 #ifdef HAVE_CONFIG_H
 #include <lynx_cfg.h>		/* generated by autoconf 'configure' script */
+#ifdef AMIGA_BSDSOCKET
+/* UP-Term: exec/types.h typedefs BOOL; include it before lynx turns BOOL into BOOLEAN */
+#include <exec/types.h>
+#endif
 
 #ifdef HAVE_STDNORETURN_H
 #include <stdnoreturn.h>
diff --git a/WWW/Library/Implementation/www_tcp.h b/WWW/Library/Implementation/www_tcp.h
index ab4cba0..a2ba82c 100644
--- a/WWW/Library/Implementation/www_tcp.h
+++ b/WWW/Library/Implementation/www_tcp.h
@@ -51,6 +51,7 @@ Default values
 #define IOCTL(s,cmd,arg)	ioctl(s,(long)(cmd),arg)
 #define SOCKET_ERRNO errno	/* normal socket errno */
 
+
 /* Unless stated otherwise, */
 #define SELECT			/* Can handle >1 channel.               */
 #define GOT_SYSTEM		/* Can call shell with string           */
@@ -1016,4 +1017,23 @@ typedef struct sockaddr_in SockA;
 #define MAXHOSTNAMELEN 128	/* Max label is 63. Should handle 2 of those */
 #endif /* MAXHOSTNAMELEN */
 
+
+/* UP-Term: with AmiSSL (AMIGA_BSDSOCKET) every socket is a bsdsocket.library socket, not an
+ * ixemul fd: AmiSSL's SSL_set_fd needs the real socket, and ixemul's read/write/close/select
+ * do not know it.  This sits at the end so the
+ * system socket headers are already in before the NDK stubs turn their prototypes into macros.  libamisslauto opens bsdsocket.library and defines SocketBase. */
+#ifdef AMIGA_BSDSOCKET
+#include <proto/bsdsocket.h>
+#include <bsdsocket/socketbasetags.h>
+#undef NETCLOSE
+#undef NETWRITE
+#undef SOCKET_READ
+#undef IOCTL
+#define NETCLOSE(s)		CloseSocket(s)
+#define NETWRITE(s,p,n)		send(s, (const void *)(p), (long)(n), 0)
+#define SOCKET_READ(s,b,l)	recv(s, (void *)(b), (long)(l), 0)
+#define IOCTL(s,cmd,arg)	IoctlSocket(s, (unsigned long)(cmd), (char *)(arg))
+#define select(n,r,w,e,t)	WaitSelect(n, r, w, e, t, NULL)
+#endif /* AMIGA_BSDSOCKET */
+
 #endif /* TCP_H */
diff --git a/src/LYMain.c b/src/LYMain.c
index 9fe5413..021fee6 100644
--- a/src/LYMain.c
+++ b/src/LYMain.c
@@ -1168,6 +1168,12 @@ int main(int argc,
      * Set up the argument list.
      */
     pgm = argv[0];
+#ifdef AMIGA_BSDSOCKET
+    /* bsdsocket.library keeps its own errno: register ours, or a non-blocking connect()
+     * leaves errno at 0 and looks like a hard failure */
+    if (SocketBase != NULL)
+	SocketBaseTags(SBTM_SETVAL(SBTC_ERRNOPTR(sizeof(errno))), (ULONG) & errno, TAG_DONE);
+#endif
     /* UP-Term: a lone --help, -h, help or ? prints the usage (same as -help) */
     if (argc == 2 && (!strcmp(argv[1], "--help") || !strcmp(argv[1], "-h")
 		      || !strcmp(argv[1], "help") || !strcmp(argv[1], "?")))
