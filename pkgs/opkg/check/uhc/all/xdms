Set PKGNAME "xdms"
Set PKGVERSION "1.3"
Set PKGURLPATH "${UHC/AMINETMIRROR}util/arc/"
Set PKGFILENAME "xDMS.lha"

CPU >NIL: CHECK 68020
IF WARN
    Echo "This package needs a 68020 CPU or better."
    Set UHCRC 20
    SKIP CleanUp
ENDIF

pkg-envcheck

Set UHCRC 0
MakeDir "${UHC/TEMPDIR}${PKGNAME}"
pushd "${UHC/TEMPDIR}${PKGNAME}"

Echo NOLINE "Fetching ${PKGURLPATH}${PKGFILENAME} ..."
aget "${PKGURLPATH}${PKGFILENAME}" QUIET
IF WARN
    Echo "Download failed, aborting..."
    Set UHCRC 20
    SKIP CleanUp
ENDIF

Echo NOLINE " Done!*nExtracting files ..."
lha >NIL: e ${PKGFILENAME} xdms/Amiga-bin/readdisk xdms/Amiga-bin/xdms xdms/xdms.txt
IF WARN
    Echo "Unarchiving failed, aborting..."
    Set UHCRC 20
    SKIP CleanUp
ENDIF

Echo NOLINE " Done!*nInstalling files..."
Copy "xdms/Amiga-bin/readdisk" "${UHCEXTBIN}"
Copy "xdms/Amiga-bin/xdms" "${UHCEXTBIN}"
Copy "xdms/xdms.txt" "${UHCEXTDOC}"

cd "${UHC/TEMPDIR}"
Echo NOLINE " Done!*nRemoving temporary files..."
Delete "${UHC/TEMPDIR}${PKGNAME}" ALL QUIET

IF NOT EXISTS "${UHCBIN}Packages/Installed"
    MakeDir >NIL: "${UHCBIN}Packages/Installed"
ENDIF

Echo "${PKGVERSION}" >"${UHCBIN}Packages/Installed/${PKGNAME}"
Echo " Done!*nInstallation complete!"

LAB CleanUp
UnSet PKGNAME
UnSet PKGVERSION
UnSet PKGURLPATH
UnSet PKGFILENAME
popd
SetResult $UHCRC
