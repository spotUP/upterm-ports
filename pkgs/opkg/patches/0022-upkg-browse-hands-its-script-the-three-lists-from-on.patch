+/* UP-Term (upkg): the browse script shows three lists, and each upkg run that reads them costs
+ * seconds on a 68k (3 s per load of upkg from a PFS3 disk, measured on a Replay 2026-10-21).
+ * This writes them with the package hash loaded once: PREFIX.all (list), PREFIX.inst
+ * (list-installed) and PREFIX.upg (list-upgradable), as a pipe gets them from those commands,
+ * except that a .inst row carries the feed's description where list-installed alone, which
+ * loads no feed, shows none for a package whose status entry has none (the browse script reads
+ * the version up to the first " - "). Each list prints to its own FILE, so stdout is untouched.
+ * 0, or 1 when a file could not be written. */
+static int upkg_write_browse_lists(const char *prefix)
+{
+    static const char *const ext[3] = { "all", "inst", "upg" };
+    char *path;
+    FILE *fp;
+    int i, err = 0;
+
+    for (i = 0; i < 3 && !err; i++) {
+        sprintf_alloc(&path, "%s.%s", prefix, ext[i]);
+        fp = fopen(path, "w");
+        if (!fp) {
+            opkg_perror(ERROR, "browse: cannot create %s", path);
+            err = 1;
+        } else {
+            if (i == 0)
+                upkg_list_find(fp, 0, NULL, 0);
+            else if (i == 1)
+                upkg_list_installed(fp, 0, NULL);
+            else
+                opkg_solver_list_upgradable(fp, 0, NULL);
+            if (ferror(fp) | fclose(fp)) {
+                opkg_perror(ERROR, "browse: cannot write %s", path);
+                err = 1;
+            }
+        }
+        free(path);
+    }
+    return err;
+}
+
+/* UP-Term (upkg): `upkg list-browse PREFIX` writes the three browse lists to PREFIX.all,
+ * PREFIX.inst and PREFIX.upg; the browse script reads them again this way after a command
+ * that changed the add-ons (one upkg run instead of three). */
+static int opkg_list_browse_cmd(int argc, char **argv)
+{
+    return upkg_write_browse_lists(argv[0]);
+}
+
 /* UP-Term (upkg): `upkg browse ARGS` runs the browse script (D1 of the browse plan) through
  * /bin/sh the way a postinst runs upkg-ask. UPKG_BROWSE replaces the script command (host
  * checks). Each argument is single-quoted; one holding a quote is refused. xsystem returns
- * the script's exit code (WEXITSTATUS), or -1 when it could not run. */
+ * the script's exit code (WEXITSTATUS), or -1 when it could not run.
+ * The lists the script shows first are written before it starts, from the package hash this
+ * run already loaded, to <dir>upkg-lists.<pid>.{all,inst,upg}: dir is TMPDIR, else T: when
+ * it exists (the Amiga), else /tmp, as the script picks its own temp file. The script finds
+ * them through UPKG_BROWSE_LISTS; when they could not be written it runs list-browse itself. */
 static int opkg_browse_cmd(int argc, char **argv)
 {
-    char *cmd = NULL, *tmp;
-    const char *sh_argv[4];
+    char *cmd = NULL, *tmp, *lists = NULL;
+    const char *sh_argv[4], *dir;
+    static const char *const ext[3] = { "all", "inst", "upg" };
     int i, r;
 
-    sprintf_alloc(&cmd, "${UPKG_BROWSE:-vsh UP-Term:bin/upkg-browse}");
+    dir = getenv("TMPDIR");
+    if (!dir || !*dir)
+        dir = access("T:", F_OK) == 0 ? "T:" : "/tmp";
+    sprintf_alloc(&lists, "%s%supkg-lists.%lu", dir,
+                  strchr(":/", dir[strlen(dir) - 1]) ? "" : "/", (unsigned long)getpid());
+    /* a list left half written is removed below with the others */
+    if (strchr(lists, '\'')) {
+        free(lists);
+        lists = NULL;
+    }
+    if (lists && !upkg_write_browse_lists(lists))
+        sprintf_alloc(&cmd, "UPKG_BROWSE_LISTS='%s' ${UPKG_BROWSE:-vsh UP-Term:bin/upkg-browse}", lists);
+    else
+        sprintf_alloc(&cmd, "${UPKG_BROWSE:-vsh UP-Term:bin/upkg-browse}");
     for (i = 0; i < argc; i++) {
         if (strchr(argv[i], '\'')) {
             opkg_msg(ERROR, "browse: an argument must not contain a single quote.\n");
             free(cmd);
-            return 2;
+            r = 2;
+            goto out;
         }
         sprintf_alloc(&tmp, "%s '%s'", cmd, argv[i]);
         free(cmd);
@@ -806,7 +877,18 @@ static int opkg_browse_cmd(int argc, char **argv)
     sh_argv[3] = NULL;
     r = xsystem(sh_argv);
     free(cmd);
-    return r < 0 ? 1 : r;
+    if (r < 0)
+        r = 1;
+ out:
+    if (lists) {
+        for (i = 0; i < 3; i++) {
+            sprintf_alloc(&tmp, "%s.%s", lists, ext[i]);
+            unlink(tmp);
+            free(tmp);
+        }
+        free(lists);
+    }
+    return r;
 }
 
 static int opkg_info_cmd(int argc, char **argv)
@@ -1236,7 +1318,7 @@ static int opkg_search_cmd(int argc, char **argv)
             installed_file = (file_info_t *)iter->data;
