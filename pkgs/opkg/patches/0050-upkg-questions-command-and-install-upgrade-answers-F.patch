@@ -37,4 +38,13 @@ unsigned long upkg_all_bytes(char **names, size_t n);
 /* `upkg install --all`: every package of the feeds that is not installed. Returns the command's rc. */
 int upkg_all_install_cli(void);
 
+/* `upkg questions PKG`: one line per question of the package's archive, tab-separated: id, kind (string, yesno,
+ * choice), default, choices (comma-separated), prompt, answered|new. 0; 5 when the package asks none; 12 unknown. */
