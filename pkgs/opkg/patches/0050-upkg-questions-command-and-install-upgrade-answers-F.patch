+/* `upkg install|upgrade [PKGS] --answers FILE`: read the id=value lines of FILE, seed them as Install All seeds its
+ * answers, run CMD unattended. A question with no answer (and not answered by an earlier install) is rc 15 naming its
+ * id on stderr; a bad answer is rc 11. With no PKGS (upgrade) every upgradable add-on is covered. */
+int upkg_answers_run(opkg_cmd_t *cmd, int argc, const char **argv, const char *file);
+
 #endif
