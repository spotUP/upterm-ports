+/* ---- the question channel for a front-end without a terminal (doc/upkg-api.txt, QUESTIONS) ---- */
+
+typedef struct {
+    char *id, *kind, *prompt, *def, *choices;
+    int answered;               /* NAME.answered holds this id: an earlier install answered it */
+} question_t;
+
+/* The questions of PKG's archive, parsed from lines "id|kind|prompt|default|choices" (*MEMBER the archive path,
+ * malloc). Returns the count, 0 when the archive has no questions file, -1 on a read failure. */
+static int read_questions(pkg_t *pkg, char **member, question_t **out)
+{
+    char *orig, *text, *state, *st, *p;
+    question_t *q = NULL;
+    int nq = 0;
+    FILE *fp;
+    pkg_t *inst;
+
+    *out = NULL;
+    *member = questions_member(pkg);
+    if (!*member)
+        return 0;
+    sprintf_alloc(&orig, "%s/%s.orig", tmpdir, pkg->name);
+    fp = fopen(orig, "wb");
+    if (!fp || pkg_extract_data_file_to_stream(pkg, *member, fp) < 0) {
+        if (fp)
+            fclose(fp);
+        opkg_msg(ERROR, "Cannot read the questions of %s.\n", pkg->name);
+        free(orig);
+        return -1;
+    }
+    fclose(fp);
+    text = slurp(orig);
+    unlink(orig);
+    free(orig);
+    if (!text)
+        return -1;
+    inst = pkg_hash_fetch_installed_by_name(pkg->name);
+    state = pkg_answered_path(inst ? inst : pkg);
+    st = slurp(state);
+    free(state);
+    for (p = text; *p;) {
+        char *e = strchr(p, '\n'), *f[5];
+        int k;
+
+        if (e)
+            *e = '\0';
+        if (*p && *p != '#') {
+            f[0] = p;
+            for (k = 1; k < 5; k++) {
+                char *b = f[k - 1] ? strchr(f[k - 1], '|') : NULL;
+
+                if (b)
+                    *b++ = '\0';
+                f[k] = b;
+            }
+            if (f[1]) {
+                size_t il = strlen(f[0]);
+                const char *a = st;
+
+                q = xrealloc(q, (size_t)(nq + 1) * sizeof *q);
+                q[nq].id = xstrdup(f[0]);
+                q[nq].kind = xstrdup(f[1]);
+                q[nq].prompt = xstrdup(f[2] ? f[2] : "");
+                q[nq].def = xstrdup(f[3] ? f[3] : "");
+                q[nq].choices = xstrdup(f[4] ? f[4] : "");
+                q[nq].answered = 0;
+                while (a && *a) {
+                    if (strncmp(a, f[0], il) == 0 && a[il] == '=' && a[il + 1] == '\'')
+                        q[nq].answered = 1;
+                    a = strchr(a, '\n');
+                    if (a)
+                        a++;
+                }
+                nq++;
+            }
+        }
+        if (!e)
+            break;
+        p = e + 1;
+    }
+    free(text);
+    free(st);
+    *out = q;
+    return nq;
+}
+
+static void free_questions(question_t *q, int n)
+{
+    int i;
+
+    for (i = 0; i < n; i++) {
+        free(q[i].id);
+        free(q[i].kind);
+        free(q[i].prompt);
+        free(q[i].def);
+        free(q[i].choices);
+    }
+    free(q);
+}
+
+/* The best candidate of NAME with its archive downloaded when NAME asks questions; else NULL with *RC the
+ * reason: 0 for a UHC name or a package that asks none, UPKG_RC_NOTFOUND for an unknown name, -1 for a failure. */
+static pkg_t *fetch_interactive(const char *name, int *rc)
+{
+    pkg_t *pkg;
+    int verbosity, rc_dl;
+
+    *rc = 0;
+    if (upkg_uhc_name(name))
+        return NULL;
+    pkg = pkg_hash_fetch_best_installation_candidate_by_name(name);
+    if (!pkg) {
+        *rc = UPKG_RC_NOTFOUND;
+        return NULL;
+    }
+    if (!upkg_rows_interactive(name))
+        return NULL;
+    /* stdout of `upkg questions` carries only question rows: no "Downloading" notice */
+    verbosity = opkg_config->verbosity;
+    opkg_config->verbosity = ERROR;
+    rc_dl = opkg_download_pkg(pkg);
+    opkg_config->verbosity = verbosity;
+    if (rc_dl != 0) {
+        opkg_msg(ERROR, "Cannot download %s to read its questions.\n", name);
+        upkg_note_fail(UPKG_RC_NETWORK);
+        *rc = -1;
+        return NULL;
+    }
+    return pkg;
+}
+
+int upkg_questions_cmd(int argc, char **argv)
+{
+    pkg_t *pkg;
+    question_t *q;
+    char *member;
+    int rc, n, i;
+
+    if (argc != 1) {
+        fprintf(stderr, "upkg: questions takes one package name\n");
+        return UPKG_RC_USAGE;
+    }
+    if (make_tmpdir() != 0)
+        return -1;
+    pkg = fetch_interactive(argv[0], &rc);
+    if (!pkg) {
+        upkg_all_end();
+        if (rc == UPKG_RC_NOTFOUND)
+            opkg_msg(ERROR, "Unknown package '%s'.\n", argv[0]);
+        return rc ? rc : UPKG_RC_NOTHING;
+    }
+    n = read_questions(pkg, &member, &q);
+    for (i = 0; i < n; i++) {
+        char *c;
+
+        /* tab-separated: a tab inside a field would break the row */
+        for (c = q[i].prompt; *c; c++)
+            if (*c == '\t' || *c == '\r')
+                *c = ' ';
+        printf("%s\t%s\t%s\t%s\t%s\t%s\n", q[i].id, q[i].kind, q[i].def, q[i].choices, q[i].prompt,
+               q[i].answered ? "answered" : "new");
+    }
+    if (n > 0)
+        free_questions(q, n);
+    free(member);
+    upkg_all_end();
+    return n < 0 ? -1 : n == 0 ? UPKG_RC_NOTHING : 0;
+}
+
+/* FILE's "id=value" lines as shell lines id='value', the form upkg_all_apply reads; malloc, NULL when unreadable. */
+static char *answers_as_shell(const char *file)
+{
+    char *text = slurp(file), *out, *o, *p;
+
+    if (!text)
+        return NULL;
+    out = o = xmalloc(strlen(text) * 4 + 2);
+    for (p = text; *p;) {
+        char *e = strchr(p, '\n'), *eq;
+        size_t len = e ? (size_t)(e - p) : strlen(p);
+
+        if (len && p[len - 1] == '\r')
+            len--;
+        eq = len && *p != '#' ? memchr(p, '=', len) : NULL;
+        if (eq && eq > p) {
+            const char *v;
+
+            memcpy(o, p, (size_t)(eq - p));
+            o += eq - p;
+            *o++ = '=';
+            *o++ = '\'';
+            for (v = eq + 1; v < p + len; v++) {
+                if (*v == '\'') {
+                    memcpy(o, "'\\''", 4);
+                    o += 4;
+                } else {
+                    *o++ = *v;
+                }
+            }
+            *o++ = '\'';
+            *o++ = '\n';
+        }
+        p = e ? e + 1 : p + strlen(p);
+    }
+    *o = '\0';
+    free(text);
+    return out;
+}
+
+/* NULL when ANS is a legal answer to Q; else the reason. */
+static const char *answer_problem(const question_t *q, const char *ans)
+{
+    if (strpbrk(ans, "|\r\n") || *ans == '<')
+        return "may not contain '|' or a line break, or start with '<'";
+    if (!strcmp(q->kind, "yesno") && strcmp(ans, "yes") && strcmp(ans, "no"))
+        return "must be yes or no";
+    if (!strcmp(q->kind, "choice")) {
+        char *list = xstrdup(q->choices), *c, *save = NULL;
+        int ok = 0;
+
+        for (c = strtok_r(list, ",", &save); c; c = strtok_r(NULL, ",", &save))
+            if (!strcmp(c, ans))
+                ok = 1;
+        free(list);
+        if (!ok)
+            return "is not one of the choices";
+    }
+    return NULL;
+}
+
+/* Seed the questions of every interactive package of NAMES from the answers (shell lines); installs nothing. */
+static int answers_seed(char **names, size_t n, const char *shell)
+{
+    size_t i;
+
+    if (make_tmpdir() != 0)
+        return -1;
+    for (i = 0; i < n; i++) {
+        pkg_t *pkg;
+        question_t *q;
+        char *member, *answered, *orig, *applied, *text;
+        int rc, nq, k;
+        FILE *fp;
+
+        pkg = fetch_interactive(names[i], &rc);
+        if (!pkg) {
+            if (rc < 0)
+                return -1;
+            continue;           /* unknown, not interactive or UHC: the command itself answers for it */
+        }
+        nq = read_questions(pkg, &member, &q);
+        if (nq < 0)
+            return -1;
+        if (nq == 0)
+            continue;
+        for (k = 0; k < nq; k++) {
+            char *ans;
+            const char *why;
+
+            if (q[k].answered)
+                continue;       /* kept from the earlier install: upkg-ask returns the recorded value */
+            ans = answer_for(shell, q[k].id, strlen(q[k].id));
+            if (!ans) {
+                fprintf(stderr, "upkg: %s needs an answer for %s\n", names[i], q[k].id);
+                upkg_note_fail(UPKG_RC_ANSWERS);
+                return -1;
+            }
+            why = answer_problem(&q[k], ans);
+            free(ans);
+            if (why) {
+                fprintf(stderr, "upkg: the answer for %s of %s %s\n", q[k].id, names[i], why);
+                upkg_note_fail(UPKG_RC_USAGE);
+                return -1;
+            }
+        }
+        sprintf_alloc(&orig, "%s/%s.orig", tmpdir, pkg->name);
+        fp = fopen(orig, "wb");
+        if (!fp || pkg_extract_data_file_to_stream(pkg, member, fp) < 0) {
+            if (fp)
+                fclose(fp);
+            opkg_msg(ERROR, "Cannot read the questions of %s.\n", pkg->name);
+            return -1;
+        }
+        fclose(fp);
+        text = slurp(orig);
+        unlink(orig);
+        free(orig);
+        applied = upkg_all_apply(text, shell);
+        free(text);
+        sprintf_alloc(&answered, "%s/%s.q", tmpdir, pkg->name);
+        if (add_seed(pkg->name, member, answered, applied) != 0)
+            return -1;
+        free(applied);
+        free_questions(q, nq);
+    }
+    upkg_xsystem_unattended(1);
+    asked = 1;
+    return 0;
+}
+
+int upkg_answers_run(opkg_cmd_t *cmd, int argc, const char **argv, const char *file)
+{
+    upkg_rows_t rows;
+    char **names;
+    char *shell;
+    size_t n;
+    int i, err, bulk = argc == 0;
+
+    memset(&rows, 0, sizeof rows);
+    shell = answers_as_shell(file);
+    if (!shell) {
+        fprintf(stderr, "upkg: cannot read the answers file %s\n", file);
+        return UPKG_RC_USAGE;
+    }
+    if (bulk) {
+        upkg_rows_load(&rows);
+        names = upkg_rows_bulk_names(&rows, 'U', &n);
+    } else {
+        names = xcalloc((size_t)argc + 1, sizeof *names);
+        for (i = 0; i < argc; i++)
+            names[i] = xstrdup(argv[i]);
+        n = (size_t)argc;
+    }
+    err = answers_seed(names, n, shell);
+    if (err == 0)
+        err = opkg_cmd_exec(cmd, argc, argv);
+    upkg_all_end();
+    if (bulk) {
+        upkg_rows_bulk_free(names);
+        upkg_rows_free(&rows);
+    } else {
+        for (i = 0; i < argc; i++)
+            free(names[i]);
+        free(names);
+    }
+    free(shell);
+    return err;
+}
