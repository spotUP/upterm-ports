diff --git a/libopkg/upkg_rows.c b/libopkg/upkg_rows.c
new file mode 100644
index 0000000..6b57fe5
--- /dev/null
+++ b/libopkg/upkg_rows.c
@@ -0,0 +1,199 @@
+/* upkg_rows.c - upkg: the add-on rows of the browse screens, without any screen (UP-Term).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "config.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "opkg_cmd.h"
+#include "pkg_hash.h"
+#include "sprintf_alloc.h"
+#include "xfuncs.h"
+#include "upkg_browse.h"
+#include "upkg_rows.h"
+
+static char *dupn(const char *s, size_t n)
+{
+    char *d = xmalloc(n + 1);
+
+    memcpy(d, s, n);
+    d[n] = '\0';
+    return d;
+}
+
+/* the first " - " in S[0..N), else NULL */
+static const char *sep_in(const char *s, size_t n)
+{
+    size_t i;
+
+    for (i = 0; i + 3 <= n; i++)
+        if (!memcmp(s + i, " - ", 3))
+            return s + i;
+    return NULL;
+}
+
+/* the text after "NAME - " in the first line of TEXT that starts so (its length in *LEN), else NULL */
+static const char *find_name(const char *text, const char *name, size_t nl, size_t *len)
+{
+    const char *p = text;
+
+    while (p && *p) {
+        const char *e = strchr(p, '\n');
+        size_t ll = e ? (size_t)(e - p) : strlen(p);
+
+        if (ll >= nl + 3 && !memcmp(p, name, nl) && !memcmp(p + nl, " - ", 3)) {
+            *len = ll - nl - 3;
+            return p + nl + 3;
+        }
+        p = e ? e + 1 : NULL;
+    }
+    return NULL;
+}
+
+void upkg_rows_free(upkg_rows_t *rows)
+{
+    size_t i;
+
+    for (i = 0; i < rows->n; i++) {
+        free(rows->row[i].name);
+        free(rows->row[i].installed);
+        free(rows->row[i].available);
+        free(rows->row[i].desc);
+    }
+    free(rows->row);
+    rows->row = NULL;
+    rows->n = 0;
+}
+
+void upkg_rows_parse(upkg_rows_t *rows, const char *all, const char *inst, const char *upg, const char *fresh)
+{
+    const char *p = all;
+    size_t lines = 0, cap;
+
+    upkg_rows_free(rows);
+    if (!all)
+        return;
+    for (p = all; *p; p++)
+        if (*p == '\n')
+            lines++;
+    cap = lines + 1;
+    rows->row = xcalloc(cap, sizeof *rows->row);
+
+    for (p = all; p && *p;) {
+        const char *e = strchr(p, '\n'), *sep, *rest, *sep2, *t;
+        size_t ll = e ? (size_t)(e - p) : strlen(p), nl, rl, vl, tl;
+        upkg_row_t *r;
+
+        sep = sep_in(p, ll);
+        if (!sep) {
+            p = e ? e + 1 : NULL;
+            continue;
+        }
+        r = &rows->row[rows->n];
+        nl = (size_t)(sep - p);
+        r->name = dupn(p, nl);
+        rest = sep + 3;
+        rl = ll - nl - 3;
+        sep2 = sep_in(rest, rl);
+        vl = sep2 ? (size_t)(sep2 - rest) : rl;
+        r->available = dupn(rest, vl);
+        r->desc = sep2 ? dupn(sep2 + 3, rl - vl - 3) : xstrdup("");
+        r->installed = xstrdup("");
+        r->kind = UPKG_ROW_AVAILABLE;
+        if (fresh && find_name(fresh, r->name, nl, &tl))
+            r->kind = UPKG_ROW_NEW;
+        if (inst && (t = find_name(inst, r->name, nl, &tl)) != NULL) {
+            const char *te = sep_in(t, tl), *u;
+            size_t ul;
+
+            free(r->installed);
+            r->installed = dupn(t, te ? (size_t)(te - t) : tl);
+            r->kind = UPKG_ROW_INSTALLED;
+            /* the upgrade line is "NAME - INSTALLED - NEW" */
+            if (upg && (u = find_name(upg, r->name, nl, &ul)) != NULL) {
+                const char *ue = sep_in(u, ul);
+
+                free(r->installed);
+                free(r->available);
+                r->installed = dupn(u, ue ? (size_t)(ue - u) : ul);
+                r->available = ue ? dupn(ue + 3, ul - (size_t)(ue - u) - 3) : xstrdup("");
+                r->kind = UPKG_ROW_UPGRADE;
+            }
+        }
+        rows->n++;
+        p = e ? e + 1 : NULL;
+    }
+}
+
+size_t upkg_rows_load(upkg_rows_t *rows)
+{
+    char *all = upkg_browse_list(0), *inst = upkg_browse_list(1), *upg = upkg_browse_list(2),
+        *fresh = upkg_browse_list(3);
+
+    upkg_rows_parse(rows, all, inst, upg, fresh);
+    free(all);
+    free(inst);
+    free(upg);
+    free(fresh);
+    return rows->n;
+}
+
+char *upkg_rows_status(const upkg_row_t *r)
+{
+    char *s = NULL;
+
+    switch (r->kind) {
+    case UPKG_ROW_UPGRADE:
+        sprintf_alloc(&s, "upgrade %s to %s", r->installed, r->available);
+        break;
+    case UPKG_ROW_INSTALLED:
+        sprintf_alloc(&s, "installed %s", r->installed);
+        break;
+    case UPKG_ROW_NEW:
+        sprintf_alloc(&s, "new %s", r->available);
+        break;
+    default:
+        sprintf_alloc(&s, "available %s", r->available);
+    }
+    return s;
+}
+
+/* After an install, remove or upgrade the hash is rebuilt from the feeds and the status files, as
+ * after a fresh start; the new markers are read from the .prev files again by the list code. */
+static void hash_reload(void)
+{
+    pkg_hash_deinit();
+    pkg_hash_init(); /* deinit leaves n_buckets 0: the next lookup would divide by zero */
+    pkg_hash_load_feeds();
+    pkg_hash_load_status_files();
+}
+
+int upkg_rows_run(upkg_rows_t *rows, const char *cmdname, const char *name, upkg_sink_fn sink)
+{
+    opkg_cmd_t *cmd = opkg_cmd_find(cmdname);
+    const char *argv[2];
+    int rc;
+
+    if (!cmd)
+        return -1;
+    argv[0] = name;
+    argv[1] = NULL;
+    upkg_wrap_flush();
+    fflush(stdout);
+    fflush(stderr);
+    if (sink)
+        upkg_set_sink(sink);
+    rc = opkg_cmd_exec(cmd, 1, argv);
+    upkg_wrap_flush();
+    fflush(stdout);
+    fflush(stderr);
+    hash_reload();
+    upkg_rows_load(rows);
+    if (sink)
+        upkg_set_sink(NULL);
+    return rc;
+}
