+++ b/libopkg/upkg_rows.h
@@ -0,0 +1,60 @@
+/* upkg_rows.h - upkg: the add-on rows of the browse screens, without any screen (UP-Term).
+ *
+ * One parser of the four lists (list, list-installed, list-upgradable, list-new) that both
+ * `upkg browse` (curses) and the Workbench window use, and the one place that runs install,
+ * remove and upgrade and rebuilds the rows afterwards. Pure C: no curses, no Intuition.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef UPKG_ROWS_H
+#define UPKG_ROWS_H
+
+#include <stddef.h>
+#include "upkg_wrap.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum {
+    UPKG_ROW_AVAILABLE,         /* in a feed, not installed */
+    UPKG_ROW_NEW,               /* in a feed, added by the last update, not installed */
+    UPKG_ROW_INSTALLED,         /* installed, nothing newer */
+    UPKG_ROW_UPGRADE            /* installed, a newer version is in a feed */
+} upkg_row_kind_t;
+
+typedef struct {
+    char *name;
+    upkg_row_kind_t kind;
+    char *installed;            /* installed version, "" when not installed */
+    char *available;            /* the feed's version (the newer one for UPKG_ROW_UPGRADE) */
+    char *desc;                 /* "" when the feed has none */
+} upkg_row_t;
+
+typedef struct {
