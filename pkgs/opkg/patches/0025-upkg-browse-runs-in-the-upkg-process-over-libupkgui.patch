@@ -146,6 +147,13 @@ if(STATIC_LIBOPKG)
 endif()
 
 # Always require libarchive
+# upkg browse draws its screens in this process: libupkgui (pkgs/upkg-ui) over ncursesw
+find_path(UPKGUI_INCLUDE_DIR upkgui/ui.h REQUIRED)
+find_library(UPKGUI_LIBRARY upkgui REQUIRED)
+find_library(NCURSESW_LIBRARY ncursesw REQUIRED)
+include_directories(${UPKGUI_INCLUDE_DIR})
+target_link_libraries(libopkg ${UPKGUI_LIBRARY} ${NCURSESW_LIBRARY})
+
 find_package(LibArchive REQUIRED)
 target_link_libraries(libopkg ${LibArchive_LIBRARIES})
 
