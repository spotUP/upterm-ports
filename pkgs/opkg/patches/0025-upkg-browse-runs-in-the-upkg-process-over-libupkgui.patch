diff --git a/libopkg/upkg_browse.c b/libopkg/upkg_browse.c
new file mode 100644
index 0000000..0570430
--- /dev/null
+++ b/libopkg/upkg_browse.c
@@ -0,0 +1,568 @@
+/* upkg_browse.c - upkg: `upkg browse`, the add-on list, in this process (UP-Term).
+ *
+ * Replaces the shell script dist/upkg-browse and its upkg-ui child processes: the list, the info
+ * box and the questions are drawn by libupkgui (ui.h) in upkg itself, from the package hash this
+ * run already loaded, and install, remove and upgrade run through opkg_cmd_exec. Nothing is
+ * forked to show a screen, which on a 68k saves a program load (about 3 s from PFS3) per screen.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "config.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <dirent.h>
+#include <sys/stat.h>
+
+#include <upkgui/ui.h>
+
+#include "opkg_conf.h"
+#include "opkg_cmd.h"
+#include "opkg_message.h"
+#include "upkg_wrap.h"
+#include "pkg_hash.h"
+#include "sprintf_alloc.h"
+#include "xfuncs.h"
+#include "upkg_browse.h"
+
+#define USAGE "usage: upkg browse\nkeys: Up Down move, Enter info, i install, r remove, u upgrade, q quit"
+#define TITLE "UP-TERM ADD-ONS"
+#define PROMPT "Enter info   i install   r remove   u upgrade   q quit"
+#define LISTS_DEFAULT "/UP-Term/pkg/upkg/lists"
+
+/* dialog colour codes of the menu: upgrade yellow, installed green, new cyan */
+#define C_UPGRADE "\\Z3"
+#define C_INSTALLED "\\Z2"
+#define C_NEW "\\Z6"
+
+static char *dupn(const char *s, size_t n)
+{
+    char *d = xmalloc(n + 1);
+
+    memcpy(d, s, n);
+    d[n] = '\0';
+    return d;
+}
+
+/* a list as text, and its lines (split in place) */
+typedef struct {
+    char *text;
+    char **line;
+    size_t n;
+} lines_t;
+
+static void lines_free(lines_t *l)
+{
+    free(l->text);
+    free(l->line);
+    l->text = NULL;
+    l->line = NULL;
+    l->n = 0;
+}
+
+/* takes TEXT (malloc), or NULL for an empty list */
+static void lines_set(lines_t *l, char *text)
+{
+    char *p;
+    size_t cap = 0;
+
+    lines_free(l);
+    if (!text)
+        return;
+    l->text = text;
+    for (p = text; *p;) {
+        char *e = strchr(p, '\n');
+
+        if (l->n == cap) {
+            cap = cap ? cap * 2 : 256;
+            l->line = xrealloc(l->line, cap * sizeof *l->line);
+        }
+        l->line[l->n++] = p;
+        if (!e)
+            break;
+        *e = '\0';
+        p = e + 1;
+    }
+}
+
+/* the text after "NAME - " in a list line, else NULL */
+static const char *after_name(const char *line, const char *name, size_t len)
+{
+    if (strncmp(line, name, len) || strncmp(line + len, " - ", 3))
+        return NULL;
+    return line + len + 3;
+}
+
+static const char *find_name(const lines_t *l, const char *name, size_t len)
+{
+    size_t i;
+    const char *r;
+
+    for (i = 0; i < l->n; i++)
+        if ((r = after_name(l->line[i], name, len)) != NULL)
+            return r;
+    return NULL;
+}
+
+static lines_t all, inst, upg, fresh;
+
+static void lists_load(void)
+{
+    lines_set(&all, upkg_browse_list(0));
+    lines_set(&inst, upkg_browse_list(1));
+    lines_set(&upg, upkg_browse_list(2));
+    lines_set(&fresh, upkg_browse_list(3));
+}
+
+/* the menu: one entry per row of the full list */
+typedef struct {
+    char *name, *status, *desc;
+    const char *colour;
+} row_t;
+
+static row_t *rows;
+static size_t nrows;
+static entry *ents;
+static char **items;
+
+static void rows_free(void)
+{
+    size_t i;
+
+    for (i = 0; i < nrows; i++) {
+        free(rows[i].name);
+        free(rows[i].status);
+        free(rows[i].desc);
+        free(items[i]);
+    }
+    free(rows);
+    free(ents);
+    free(items);
+    rows = NULL;
+    ents = NULL;
+    items = NULL;
+    nrows = 0;
+}
+
+/* The rows "installed V", "upgrade X to Y", "available V" or "new V", the status padded to the
+ * widest so the descriptions line up. A colour code takes no column. */
+static void rows_build(void)
+{
+    size_t i, w = 0;
+
+    rows_free();
+    rows = xcalloc(all.n, sizeof *rows);
+    items = xcalloc(all.n, sizeof *items);
+    ents = xcalloc(all.n, sizeof *ents);
+
+    for (i = 0; i < all.n; i++) {
+        const char *line = all.line[i], *sep = strstr(line, " - "), *rest, *sep2, *t;
+        row_t *r;
+        char *ver;
+        size_t nl, vl;
+
+        if (!sep)
+            continue;
+        r = &rows[nrows];
+        nl = (size_t)(sep - line);
+        r->name = dupn(line, nl);
+        rest = sep + 3;
+        sep2 = strstr(rest, " - ");
+        vl = sep2 ? (size_t)(sep2 - rest) : strlen(rest);
+        ver = dupn(rest, vl);
+        r->desc = xstrdup(sep2 ? sep2 + 3 : "");
+        r->colour = "";
+        sprintf_alloc(&r->status, "available %s", ver);
+        if (find_name(&fresh, r->name, nl)) {
+            free(r->status);
+            r->colour = C_NEW;
+            sprintf_alloc(&r->status, "new %s", ver);
+        }
+        if ((t = find_name(&inst, r->name, nl)) != NULL) {
+            const char *u = find_name(&upg, r->name, nl), *te = strstr(t, " - ");
+
+            free(r->status);
+            if (u) {
+                const char *ue = strstr(u, " - ");
+                /* the line is "NAME - INSTALLED - NEW" */
+                r->colour = C_UPGRADE;
+                sprintf_alloc(&r->status, "upgrade %.*s to %s", (int)(ue ? (size_t)(ue - u) : strlen(u)),
+                             u, ue ? ue + 3 : "");
+            } else {
+                r->colour = C_INSTALLED;
+                sprintf_alloc(&r->status, "installed %.*s", (int)(te ? (size_t)(te - t) : strlen(t)), t);
+            }
+        }
+        free(ver);
+        if (strlen(r->status) > w)
+            w = strlen(r->status);
+        nrows++;
+    }
+
+    for (i = 0; i < nrows; i++) {
+        row_t *r = &rows[i];
+
+        if (*r->desc) {
+            sprintf_alloc(&items[i], "%s%-*s   %s", r->colour, (int)w, r->status, r->desc);
+        } else {
+            sprintf_alloc(&items[i], "%s%s", r->colour, r->status);
+        }
+        ents[i].tag = r->name;
+        ents[i].item = items[i];
+    }
+}
+
+/* true when a feed's control for NAME has "UP-Term-Interactive: yes" (the package asks questions
+ * of its own). The feed texts are in the lists dir, one file per feed; *.prev and *.sig are not
+ * feeds. A "Package: " line sets the current name. */
+static int interactive(const char *name)
+{
+    const char *dir = getenv("UPKG_LISTS_DIR");
+    DIR *d;
+    struct dirent *de;
+    int found = 0;
+
+    if (!dir || !*dir)
+        dir = opkg_config && opkg_config->lists_dir ? opkg_config->lists_dir : LISTS_DEFAULT;
+    d = opendir(dir);
+    if (!d)
+        return 0;
+    while (!found && (de = readdir(d)) != NULL) {
+        size_t n = strlen(de->d_name);
+        char *path, cur[512], line[1024];
+        struct stat st;
+        FILE *fp;
+
+        if ((n >= 5 && !strcmp(de->d_name + n - 5, ".prev")) || (n >= 4 && !strcmp(de->d_name + n - 4, ".sig")))
+            continue;
+        sprintf_alloc(&path, "%s/%s", dir, de->d_name);
+        fp = stat(path, &st) == 0 && S_ISREG(st.st_mode) ? fopen(path, "r") : NULL;
+        free(path);
+        if (!fp)
+            continue;
+        cur[0] = '\0';
+        while (fgets(line, sizeof line, fp)) {
+            size_t k = strlen(line);
+
+            while (k && (line[k - 1] == '\n' || line[k - 1] == '\r'))
+                line[--k] = '\0';
+            if (!strncmp(line, "Package: ", 9)) {
+                snprintf(cur, sizeof cur, "%s", line + 9);
+            } else if (!strcmp(line, "UP-Term-Interactive: yes") && !strcmp(cur, name)) {
+                found = 1;
+                break;
+            }
+        }
+        fclose(fp);
+    }
+    closedir(d);
+    return found;
+}
+
+static void quit_screen(void)
+{
+    ui_stop();
+    fputs("\033[H\033[2J", stdout);
+    fflush(stdout);
+}
+
+/* a message in the frame, never in the Shell window */
+static int msg(const char *fmt, const char *tag)
+{
+    return ui_message(fmt, tag);
+}
+
+/* The sink of upkg_wrap.c while an action runs: text pieces (upkg's own messages and the output of
+ * package scripts and curl) become lines of the progress box as they complete, so the box shows a
+ * script's first line while the script is still running. */
+static char *partial;
+static size_t plen, pcap;
+
+static void sink_line(void)
+{
+    if (plen == pcap) {
+        pcap = pcap ? pcap * 2 : 256;
+        partial = xrealloc(partial, pcap);
+    }
+    partial[plen] = '\0';
+    ui_program_line(partial);
+    plen = 0;
+}
+
+static void box_sink(const char *text, size_t len)
+{
+    size_t i;
+
+    for (i = 0; i < len; i++) {
+        char c = text[i];
+
+        if (c == '\r')
+            continue;
+        if (plen + 2 >= pcap) {
+            pcap = pcap ? pcap * 2 : 256;
+            partial = xrealloc(partial, pcap);
+        }
+        partial[plen++] = c;
+        if (c == '\n')
+            sink_line();
+    }
+}
+
+static void box_sink_end(void)
+{
+    if (plen) {
+        partial[plen++] = '\n';
+        sink_line();
+    }
+}
+
+/* After an install, remove or upgrade the hash is rebuilt from the feeds and the status files, as
+ * after a fresh start; the new markers are read from the .prev files again by the list code. */
+static void hash_reload(void)
+{
+    pkg_hash_deinit();
+    pkg_hash_load_feeds();
+    pkg_hash_load_status_files();
+}
+
+static void flush_all(void)
+{
+    upkg_wrap_flush();
+    fflush(stdout);
+    fflush(stderr);
+}
+
+/* Run the opkg command CMDNAME on TAG. A package with install questions of its own runs in the
+ * plain window; any other shows its output in a box that waits for OK. Returns 0, or 1 when the
+ * terminal went away. */
+static int run_action(const char *cmdname, const char *tag)
+{
+    opkg_cmd_t *cmd = opkg_cmd_find(cmdname);
+    const char *argv[2];
+    char *title, *closing;
+    int rc;
+
+    argv[0] = tag;
+    argv[1] = NULL;
+    sprintf_alloc(&title, "upkg %s %s", cmdname, tag);
+
+    if (interactive(tag)) {
+        char junk[64];
+
+        ui_suspend();
+        rc = opkg_cmd_exec(cmd, 1, argv);
+        flush_all();
+        if (rc == 0)
+            printf("[OK] %s\n", title);
+        else
+            printf("[ERROR] %s (exit %d)\n", title, rc);
+        printf("Press Return to go back to the list.\n");
+        fflush(stdout);
+        if (!fgets(junk, sizeof junk, stdin))
+            junk[0] = '\0';
+        ui_resume();
+        free(title);
+        return 0;
+    }
+
+    ui_program_begin(title);
+    flush_all();
+    upkg_set_sink(box_sink);
+    rc = opkg_cmd_exec(cmd, 1, argv);
+    upkg_set_sink(NULL);
+    box_sink_end();
+    if (rc == 0) {
+        sprintf_alloc(&closing, "[OK] %s\n", title);
+    } else {
+        sprintf_alloc(&closing, "[ERROR] %s (exit %d)\n", title, rc);
+    }
+    ui_program_line(closing);
+    free(closing);
+    ui_program_done();
+    rc = ui_view(K_PROGRAM, title, NULL);
+    free(title);
+    return rc == EXIT_NO_TERMINAL;
+}
+
+/* The key's action on TAG, with its checks. Returns 1 when the add-ons changed, 2 when the
+ * terminal went away, else 0. */
+static int act(int key, const char *tag, int isinst, int isupg)
+{
+    const char *cmd = NULL;
+    int r;
+
+    switch (key) {
+    case 'i':
+        if (isinst)
+            msg("%s is already installed.", tag);
+        else
+            cmd = "install";
+        break;
+    case 'r':
+        if (!isinst) {
+            msg("%s is not installed.", tag);
+        } else {
+            char *q;
+
+            sprintf_alloc(&q, "Remove %s?", tag);
+            ui_opt.defaultno = 1;
+            r = ui_view(K_YESNO, q, NULL);
+            ui_opt.defaultno = 0;
+            free(q);
+            if (r == EXIT_NO_TERMINAL)
+                return 2;
+            if (r == 0)
+                cmd = "remove";
+        }
+        break;
+    case 'u':
+        if (!isupg)
+            msg("%s has no newer version.", tag);
+        else
+            cmd = "upgrade";
+        break;
+    }
+    if (!cmd)
+        return 0;
+    return run_action(cmd, tag) ? 2 : 1;
+}
+
+/* the info text of TAG in a scrollable box with the buttons that apply; returns the label of
+ * the chosen button, "" for Back, Escape or a closed box, or NULL when the terminal went away */
+static const char *info_box(const char *tag, int isinst, int isupg)
+{
+    char *text = upkg_browse_info(tag), *p, *e;
+    const char *buttons = isupg ? "Upgrade,Remove,Back" : isinst ? "Remove,Back" : "Install,Back";
+    int rc;
+
+    ui_clear_lines();
+    for (p = text; p && *p; p = e ? e + 1 : NULL) {
+        e = strchr(p, '\n');
+        if (e)
+            *e = '\0';
+        ui_add_line(p);
+        if (!e)
+            break;
+    }
+    free(text);
+    rc = ui_view(K_TEXTBOX, "", buttons);
+    if (rc == EXIT_NO_TERMINAL)
+        return NULL;
+    return rc == 0 ? ui_button() : "";
+}
+
+int upkg_browse(int argc, char **argv)
+{
+    char *last = NULL, count[64];
+    int rc, stale = 0;
+
+    if (argc == 1 && (!strcmp(argv[0], "--help") || !strcmp(argv[0], "-h") || !strcmp(argv[0], "help") ||
+                      !strcmp(argv[0], "?"))) {
+        puts(USAGE);
+        return 0;
+    }
+    if (argc > 0) {
+        fprintf(stderr, "%s\n", USAGE);
+        return 2;
+    }
+    if (!isatty(0)) {
+        fprintf(stderr, "upkg browse needs a terminal. Use upkg list.\n");
+        return 2;
+    }
+
+    lists_load();
+    if (!all.n) {
+        fprintf(stderr, "No package lists. Run upkg update first.\n");
+        return 1;
+    }
+
+    ui_opt.kind = K_MENU;
+    ui_opt.title = TITLE;
+    rc = ui_start("upkg browse");
+    if (rc) {
+        lines_free(&all);
+        return 2;
+    }
+
+    for (;;) {
+        int key, isinst, isupg, sel;
+        const char *tag;
+        size_t tl;
+
+        if (stale) {
+            hash_reload();
+            lists_load();
+            stale = 0;
+        }
+        rows_build();
+        snprintf(count, sizeof count, "%lu add-ons", (unsigned long)nrows);
+        ui_opt.backtitle = count;
+        ui_opt.entries = ents;
+        ui_opt.nentries = (int)nrows;
+        ui_opt.default_item = last;
+        ui_opt.hotkeys = "iruq";
+        ui_opt.colors = 1;
+        ui_prepare();
+        rc = ui_view(K_MENU, PROMPT, NULL);
+        ui_opt.hotkeys = NULL;
+        ui_opt.colors = 0;
+        if (rc == EXIT_NO_TERMINAL) {
+            ui_stop();
+            fputs("upkg browse: the terminal went away (no more keys)\n", stderr);
+            rc = 2;
+            break;
+        }
+        if (rc != 0 || !nrows) {
+            rc = 0;
+            quit_screen();
+            break;
+        }
+        key = ui_hotkey();
+        sel = ui_selected();
+        if (key == 'q') {
+            rc = 0;
+            quit_screen();
+            break;
+        }
+        tag = ents[sel].tag;
+        free(last);
+        last = xstrdup(tag);
+        tl = strlen(tag);
+        isinst = find_name(&inst, tag, tl) != NULL;
+        isupg = find_name(&upg, tag, tl) != NULL;
+
+        if (key == 0) {
+            const char *b = info_box(last, isinst, isupg);
+
+            if (!b) {
+                ui_stop();
+                fputs("upkg browse: the terminal went away (no more keys)\n", stderr);
+                rc = 2;
+                break;
+            }
+            key = !strcmp(b, "Install") ? 'i' : !strcmp(b, "Remove") ? 'r' : !strcmp(b, "Upgrade") ? 'u' : 0;
+        }
+        if (key) {
+            int r = act(key, last, isinst, isupg);
+
+            if (r == 2) {
+                ui_stop();
+                fputs("upkg browse: the terminal went away (no more keys)\n", stderr);
+                rc = 2;
+                break;
+            }
+            stale = r == 1;
+        }
+    }
+
+    rows_free();
+    lines_free(&all);
+    lines_free(&inst);
+    lines_free(&upg);
+    lines_free(&fresh);
+    free(last);
+    return rc;
+}
