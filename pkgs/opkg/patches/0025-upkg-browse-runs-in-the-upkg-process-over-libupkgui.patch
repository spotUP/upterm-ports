 libopkg/opkg_cmd.c     | 148 ++++-------
 libopkg/upkg_browse.c  | 568 +++++++++++++++++++++++++++++++++++++++++
 libopkg/upkg_browse.h  |  25 ++
 libopkg/upkg_wrap.c    |  41 ++-
 libopkg/upkg_wrap.h    |   8 +
 libopkg/xsystem.c      |  35 +++
 7 files changed, 728 insertions(+), 105 deletions(-)
 create mode 100644 libopkg/upkg_browse.c
 create mode 100644 libopkg/upkg_browse.h

