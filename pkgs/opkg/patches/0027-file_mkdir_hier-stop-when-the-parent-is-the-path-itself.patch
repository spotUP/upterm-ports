From ecf8549955260a3c6344dacbf9a8972c02fdafd9 Mon Sep 17 00:00:00 2001
From: spotUP <retroranksmail@gmail.com>
Date: Fri, 23 Oct 2026 07:33:11 +0200
Subject: [PATCH] file_mkdir_hier: stop when the parent is the path itself
 (absent volume root recursed forever)

---
 libopkg/file_util.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/libopkg/file_util.c b/libopkg/file_util.c
index a51c7df..806fd3d 100644
--- a/libopkg/file_util.c
+++ b/libopkg/file_util.c
@@ -363,7 +363,12 @@ int file_mkdir_hier(const char *path, long mode)
         char *parent;
 
         parent = xdirname(path);
-        status = file_mkdir_hier(parent, mode | 0300);
+        /* A path whose parent is itself (an absent Amiga volume root such as NOSUCHVOL:) never reaches an
+         * existing directory: recursing on it overflowed the stack. */
+        if (strcmp(parent, path) == 0)
+            status = -1;
+        else
+            status = file_mkdir_hier(parent, mode | 0300);
         free(parent);
 
         if (status < 0)
-- 
