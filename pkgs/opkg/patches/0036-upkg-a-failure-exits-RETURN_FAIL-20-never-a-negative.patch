From e14fcddbe82324e80d91fd1c4827cddf8ca8b410 Mon Sep 17 00:00:00 2001
From: spotUP <retroranksmail@gmail.com>
Date: Mon, 26 Oct 2026 03:55:17 +0100
Subject: [PATCH] upkg: a failure exits RETURN_FAIL (20), never a negative
 code: the AmigaOS Shell prints Unknown command for one

---
 src/opkg.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/opkg.c b/src/opkg.c
index f0788d2..48774b2 100644
--- a/src/opkg.c
+++ b/src/opkg.c
@@ -589,6 +589,9 @@ static int upkg_command_index(int argc, char **argv)
     return idx;
 }
 
+/* AmigaOS RETURN_FAIL */
+#define UPKG_RC_FAIL 20
+
 int main(int argc, char *argv[])
 {
     int opts, err = -1, full_argc, cmd_at;
@@ -735,5 +738,8 @@ int main(int argc, char *argv[])
     opkg_conf_deinit();
 
  err0:
-    return err;
+    /* err starts at -1 and several commands return -1. A negative code is no AmigaOS return code: the
+     * Shell reads it as "Unknown command" after the real message. A failure is RETURN_FAIL (20), the
+     * same on the host; the positive codes a command returns itself (1: nothing matched) stay. */
+    return err < 0 ? UPKG_RC_FAIL : err;
 }
