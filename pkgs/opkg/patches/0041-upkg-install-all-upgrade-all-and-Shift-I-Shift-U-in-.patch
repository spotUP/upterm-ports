+}
+
+/* Run CMDNAME on ARGC names in ARGV and show its output in a box titled TITLE that waits for OK.
+ * Returns 1 when the terminal went away, else 0. */
+static int run_box(const char *title, const char *cmdname, int argc, const char **argv)
+{
