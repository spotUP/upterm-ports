     int rc;
 
     sprintf_alloc(&title, "upkg %s %s", cmdname, tag);
@@ -198,8 +202,20 @@ static int run_action(const char *cmdname, const char *tag)
         return 0;
     }
 
+    rc = run_box(title, cmdname, tag ? 1 : 0, &tag);
+    free(title);
