+    int rc;
+
     ui_program_begin(title);
-    rc = upkg_rows_run(&rows, cmdname, tag, box_sink);
+    rc = upkg_rows_run_names(&rows, cmdname, argc, argv, box_sink);
     box_sink_end();
     if (rc == 0) {
         sprintf_alloc(&closing, "[OK] %s\n", title);
@@ -210,10 +226,60 @@ static int run_action(const char *cmdname, const char *tag)
