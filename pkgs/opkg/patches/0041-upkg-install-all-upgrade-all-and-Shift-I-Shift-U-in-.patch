diff --git a/libopkg/upkg_all.c b/libopkg/upkg_all.c
new file mode 100644
index 0000000..6561079
--- /dev/null
+++ b/libopkg/upkg_all.c
@@ -0,0 +1,342 @@
+/* upkg_all.c - Install All: ask every install question once, then install unattended. See upkg_all.h. */
+#include "config.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/stat.h>
+
+#include "opkg_conf.h"
+#include "opkg_cmd.h"
+#include "opkg_download.h"
+#include "opkg_message.h"
+#include "pkg_extract.h"
+#include "pkg_hash.h"
+#include "sprintf_alloc.h"
+#include "xfuncs.h"
+#include "xsystem.h"
+#include "upkg_rows.h"
+#include "upkg_all.h"
+
+#define STAGE_DIR "T/upkg-stage/"
+#define QUESTIONS_TAIL "/Files/questions"
+
+typedef struct {
+    char *name;
+    char *member;               /* archive path of the questions file, "T/upkg-stage/NAME/Files/questions" */
+    char *answered;             /* file holding the answered questions */
+} seed_t;
+
+static seed_t *seeds;
+static size_t nseeds;
+static char *tmpdir;
+
+static char *slurp(const char *path)
+{
+    FILE *fp = fopen(path, "rb");
+    char *buf;
+    long len;
+
+    if (!fp)
+        return NULL;
+    fseek(fp, 0, SEEK_END);
+    len = ftell(fp);
+    fseek(fp, 0, SEEK_SET);
+    buf = xmalloc((size_t)len + 1);
+    len = (long)fread(buf, 1, (size_t)len, fp);
+    buf[len] = '\0';
+    fclose(fp);
+    return buf;
+}
+
+/* The value of KEY in ANSWERS (lines KEY='value', ' written '\''); malloc, NULL when absent. */
+static char *answer_for(const char *answers, const char *key, size_t kl)
+{
+    const char *p = answers;
+
+    while (p && *p) {
+        const char *e = strchr(p, '\n');
+
+        if (strncmp(p, key, kl) == 0 && p[kl] == '=' && p[kl + 1] == '\'') {
+            const char *v = p + kl + 2, *end = e ? e : v + strlen(v);
+            char *out = xmalloc((size_t)(end - v) + 1), *o = out;
+
+            while (v < end) {
+                if (strncmp(v, "'\\''", 4) == 0) {
+                    *o++ = '\'';
+                    v += 4;
+                } else if (*v == '\'' && v + 1 >= end) {
+                    break;
+                } else {
+                    *o++ = *v++;
+                }
+            }
+            *o = '\0';
+            return out;
+        }
+        p = e ? e + 1 : NULL;
+    }
+    return NULL;
+}
+
+char *upkg_all_apply(const char *questions, const char *answers)
+{
+    size_t cap = strlen(questions) + strlen(answers) + 2, len = 0;
+    char *out = xmalloc(cap);
+    const char *p = questions;
+
+    while (*p) {
+        const char *e = strchr(p, '\n'), *end = e ? e : p + strlen(p);
+        const char *bar[4] = { NULL, NULL, NULL, NULL };
+        const char *q;
+        int nb = 0;
+        char *ans = NULL;
+
+        if (*p != '#')
+            for (q = p; q < end && nb < 4; q++)
+                if (*q == '|')
+                    bar[nb++] = q;
+        if (nb >= 3)
+            ans = answer_for(answers, p, (size_t)(bar[0] - p));
+        if (ans && (strpbrk(ans, "|\r\n") || *ans == '<')) {
+            free(ans);
+            ans = NULL;
+        }
+        if (ans) {
+            const char *tail = nb == 4 ? bar[3] : end;     /* from the '|' that opens the choices */
+
+            len += (size_t)snprintf(out + len, cap - len, "%.*s|%s%.*s", (int)(bar[2] - p), p, ans,
+                                     (int)(end - tail), tail);
+            free(ans);
+        } else {
+            len += (size_t)snprintf(out + len, cap - len, "%.*s", (int)(end - p), p);
+        }
+        if (e)
+            out[len++] = '\n';
+        out[len] = '\0';
+        p = e ? e + 1 : end;
+    }
+    return out;
+}
+
+/* The archive path of the questions file in PKG's data archive, or NULL. */
+static char *questions_member(pkg_t *pkg)
+{
+    FILE *fp = tmpfile();
+    char line[1024], *found = NULL;
+
+    if (!fp)
+        return NULL;
+    if (pkg_extract_data_file_names_to_stream(pkg, fp) < 0) {
+        fclose(fp);
+        return NULL;
+    }
+    rewind(fp);
+    while (!found && fgets(line, sizeof line, fp)) {
+        char *tab = strchr(line, '\t'), *path = line;
+        size_t n;
+
+        if (tab)
+            *tab = '\0';
+        if (strncmp(path, "./", 2) == 0)
+            path += 2;
+        n = strlen(path);
+        if (strncmp(path, STAGE_DIR, strlen(STAGE_DIR)) == 0 && n > strlen(STAGE_DIR) + strlen(QUESTIONS_TAIL)
+            && strcmp(path + n - strlen(QUESTIONS_TAIL), QUESTIONS_TAIL) == 0)
+            found = xstrdup(path);
+    }
+    fclose(fp);
+    return found;
+}
+
+/* The archive name between T/upkg-stage/ and /Files/questions (upkg-ask's NAME argument). */
+static char *member_archive(const char *member)
+{
+    size_t a = strlen(STAGE_DIR), n = strlen(member) - a - strlen(QUESTIONS_TAIL);
+    char *s = xmalloc(n + 1);
+
+    memcpy(s, member + a, n);
+    s[n] = '\0';
+    return s;
+}
+
+static int ask_one(pkg_t *pkg)
+{
+    const char *cmd = getenv("UPKG_ASK_CMD");
+    char *member = questions_member(pkg), *archive, *orig, *ans, *text, *answers, *answered, *script, *applied;
+    const char *argv[8];
+    FILE *fp;
+    int rc;
+
+    if (!member)
+        return 0;               /* interactive in the index, but no questions file: nothing to seed */
+    archive = member_archive(member);
+    sprintf_alloc(&orig, "%s/%s.orig", tmpdir, pkg->name);
+    sprintf_alloc(&ans, "%s/%s.ans", tmpdir, pkg->name);
+    sprintf_alloc(&answered, "%s/%s.q", tmpdir, pkg->name);
+
+    fp = fopen(orig, "wb");
+    if (!fp || pkg_extract_data_file_to_stream(pkg, member, fp) < 0) {
+        if (fp)
+            fclose(fp);
+        opkg_msg(ERROR, "Cannot read the questions of %s.\n", pkg->name);
+        return -1;
+    }
+    fclose(fp);
+
+    if (!cmd || !*cmd)
+        cmd = "[ -f UP-Term:bin/upkg-ask ] && vsh UP-Term:bin/upkg-ask";
+    sprintf_alloc(&script, "%s \"$0\" \"$1\" \"$2\"", cmd);
+    argv[0] = "sh";
+    argv[1] = "-c";
+    argv[2] = script;
+    argv[3] = orig;
+    argv[4] = ans;
+    argv[5] = archive;
+    argv[6] = NULL;
+    rc = xsystem(argv);
+    answers = rc == 0 ? slurp(ans) : NULL;
+    text = slurp(orig);
+    unlink(orig);
+    unlink(ans);
+    free(script);
+    if (!answers || !text) {
+        free(answers);
+        free(text);
+        opkg_msg(ERROR, "The questions of %s were not answered.\n", pkg->name);
+        return -1;
+    }
+    applied = upkg_all_apply(text, answers);
+    fp = fopen(answered, "wb");
+    if (!fp || fputs(applied, fp) < 0) {
+        opkg_msg(ERROR, "Cannot write the answers of %s.\n", pkg->name);
+        return -1;
+    }
+    fclose(fp);
+    free(applied);
+    free(answers);
+    free(text);
+
+    seeds = xrealloc(seeds, (nseeds + 1) * sizeof *seeds);
+    seeds[nseeds].name = xstrdup(pkg->name);
+    seeds[nseeds].member = member;
+    seeds[nseeds].answered = answered;
+    nseeds++;
+    free(archive);
+    free(orig);
+    free(ans);
+    return 0;
+}
+
+int upkg_all_ask(char **names, size_t n)
+{
+    size_t i;
+    char *base;
+
+    sprintf_alloc(&base, "%s/upkg-all.XXXXXX", opkg_config && opkg_config->tmp_dir ? opkg_config->tmp_dir : "/tmp");
+    tmpdir = mkdtemp(base);
+    if (!tmpdir) {
+        opkg_msg(ERROR, "Cannot make a work directory under %s.\n", base);
+        free(base);
+        return -1;
+    }
+    for (i = 0; i < n; i++) {
+        pkg_t *pkg;
+
+        if (!upkg_rows_interactive(names[i]))
+            continue;
+        pkg = pkg_hash_fetch_best_installation_candidate_by_name(names[i]);
+        if (!pkg)
+            continue;
+        if (opkg_download_pkg(pkg) != 0) {
+            opkg_msg(ERROR, "Cannot download %s to ask its questions.\n", names[i]);
+            return -1;
+        }
+        if (ask_one(pkg) != 0)
+            return -1;
+    }
+    upkg_xsystem_unattended(1);
+    return 0;
+}
+
+void upkg_all_seed(pkg_t *pkg)
+{
+    size_t i;
+
+    for (i = 0; i < nseeds; i++) {
+        char *dest, *text;
+        FILE *fp;
+
+        if (strcmp(seeds[i].name, pkg->name) != 0)
+            continue;
+        text = slurp(seeds[i].answered);
+        sprintf_alloc(&dest, "%s/%s", pkg->dest->root_dir, seeds[i].member);
+        fp = text ? fopen(dest, "wb") : NULL;
+        if (fp) {
+            fputs(text, fp);
+            fclose(fp);
+        } else {
+            opkg_msg(ERROR, "Cannot write the answers of %s to %s.\n", pkg->name, dest);
+        }
+        free(text);
+        free(dest);
+    }
+}
+
+void upkg_all_end(void)
+{
+    size_t i;
+
+    upkg_xsystem_unattended(0);
+    for (i = 0; i < nseeds; i++) {
+        unlink(seeds[i].answered);
+        free(seeds[i].name);
+        free(seeds[i].member);
+        free(seeds[i].answered);
+    }
+    free(seeds);
+    seeds = NULL;
+    nseeds = 0;
+    if (tmpdir) {
+        rmdir(tmpdir);
+        free(tmpdir);
+        tmpdir = NULL;
+    }
+}
+
+unsigned long upkg_all_bytes(char **names, size_t n)
+{
+    unsigned long total = 0;
+    size_t i;
+
+    for (i = 0; i < n; i++) {
+        pkg_t *pkg = pkg_hash_fetch_best_installation_candidate_by_name(names[i]);
+
+        if (pkg)
+            total += pkg->size;
+    }
+    return total;
+}
+
+int upkg_all_install_cli(void)
+{
+    upkg_rows_t rows = { 0 };
+    char **names;
+    size_t n;
+    int rc = 0;
+
+    upkg_rows_load(&rows);
+    names = upkg_rows_bulk_names(&rows, 'I', &n);
+    if (n == 0) {
+        printf("Every add-on in the feeds is installed.\n");
+    } else if (upkg_all_ask(names, n) != 0) {
+        rc = -1;
+    } else {
+        rc = upkg_rows_run_names(&rows, "install", (int)n, (const char **)names, NULL);
+    }
+    upkg_all_end();
+    upkg_rows_bulk_free(names);
+    upkg_rows_free(&rows);
+    return rc;
+}
diff --git a/libopkg/upkg_all.h b/libopkg/upkg_all.h
new file mode 100644
index 0000000..2d89217
--- /dev/null
+++ b/libopkg/upkg_all.h
@@ -0,0 +1,38 @@
+/* upkg_all.h - Install All: ask every install question once, then install unattended.
+ *
+ * A package that asks questions carries them in its archive (T/upkg-stage/NAME/Files/questions, lines
+ * "key|type|prompt|default|choices"); its postinst runs UP-Term:bin/upkg-ask over that file. Install All
+ * runs the very same upkg-ask for every such package before any install, then rewrites the default field
+ * of each question to the answer given and copies the file over the one the package extracts. The
+ * unchanged postinst then runs upkg-ask without a terminal, which answers with the defaults: the answers
+ * given up front. */
+#ifndef UPKG_ALL_H
+#define UPKG_ALL_H
+
+#include <stddef.h>
+#include "pkg.h"
+
+/* QUESTIONS with the default field of every question that ANSWERS (shell lines KEY='value' as upkg-ask
+ * writes them) answers replaced by the answer; malloc. An answer that holds '|', a line break or starts
+ * with '<' (a default file reference) cannot be a default field and leaves that question as it was. */
+char *upkg_all_apply(const char *questions, const char *answers);
+
+/* Download the packages of NAMES that ask questions (UP-Term-Interactive) and ask their questions through
+ * upkg-ask (the command in $UPKG_ASK_CMD, else UP-Term:bin/upkg-ask), on the terminal. Keeps the answers
+ * for upkg_all_seed and makes script children read nothing from the terminal. Returns 0, or -1 when a
+ * download or the asking failed (nothing has been installed then; call upkg_all_end). */
+int upkg_all_ask(char **names, size_t n);
+
+/* Called when PKG's data files are extracted: replaces its questions file with the answered one. */
+void upkg_all_seed(pkg_t *pkg);
+
+/* Forget the answers, delete the files, let script children read the terminal again. */
+void upkg_all_end(void);
+
+/* The download size in bytes of the best candidate of every name of NAMES. */
+unsigned long upkg_all_bytes(char **names, size_t n);
+
+/* `upkg install --all`: every package of the feeds that is not installed. Returns the command's rc. */
+int upkg_all_install_cli(void);
+
+#endif
