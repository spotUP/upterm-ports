-    free(title);
     return rc == EXIT_NO_TERMINAL;
 }
 
+/* Shift+I (OP 'I', Install All) and Shift+U (OP 'U', Update All): a yes/no with the count and the total
+ * download, No does nothing; Yes asks every install question first (Install All), then runs the install or
+ * the upgrade of everything in one box. Returns 1 when the add-ons changed, 2 when the terminal went away,
+ * else 0. */
+static int act_bulk(int op)
+{
+    size_t n;
+    char **names = upkg_rows_bulk_names(&rows, op, &n), *q, title[64];
+    int r, ret = 0;
+
+    if (n == 0) {
+        msg(op == 'I' ? "Every add-on is installed." : "Every installed add-on is up to date.", NULL);
+        upkg_rows_bulk_free(names);
+        return 0;
+    }
+    q = upkg_rows_bulk_text(op, n, upkg_all_bytes(names, n));
+    ui_opt.defaultno = 1;
+    r = ui_view(K_YESNO, q, NULL);
+    ui_opt.defaultno = 0;
+    free(q);
+    if (r == EXIT_NO_TERMINAL) {
+        upkg_rows_bulk_free(names);
+        return 2;
+    }
+    if (r != 0) {
+        upkg_rows_bulk_free(names);
+        return 0;
+    }
+    if (op == 'I') {
+        int asked;
+
+        ui_suspend();
+        asked = upkg_all_ask(names, n);
+        ui_resume();
+        if (asked != 0) {
+            upkg_all_end();
+            msg("The questions were not answered. Nothing was installed.", NULL);
+            upkg_rows_bulk_free(names);
+            return 0;
+        }
+        snprintf(title, sizeof title, "upkg install --all");
+        ret = run_box(title, "install", (int)n, (const char **)names) ? 2 : 1;
+        upkg_all_end();
+    } else {
+        snprintf(title, sizeof title, "upkg upgrade --all");
+        ret = run_box(title, "upgrade", 0, NULL) ? 2 : 1;
+    }
+    upkg_rows_bulk_free(names);
+    return ret;
+}
+
 /* The key's action on TAG, with its checks. Returns 1 when the add-ons changed, 2 when the
  * terminal went away, else 0. */
 static int act(int key, const char *tag, int isinst, int isupg)
@@ -221,6 +287,8 @@ static int act(int key, const char *tag, int isinst, int isupg)
     const char *cmd = NULL;
