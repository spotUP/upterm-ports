-#define USAGE "usage: upkg browse\nkeys: Up Down move, Enter info (launch when the add-on has a Launch line), i install, Delete remove, u upgrade, q quit"
+#define USAGE "usage: upkg browse\nkeys: Up Down move, Enter info (launch when the add-on has a Launch line), i install, Delete remove, u upgrade, I install all, U update all, q quit"
 #define TITLE "UP-TERM ADD-ONS"
 #define PROMPT "Enter info or launch   i install   Delete remove   u upgrade   q quit"
 
@@ -105,6 +106,7 @@ static void menu_build(void)
             sprintf_alloc(&items[i], "%s%s", colour, status[i]);
         }
         free(status[i]);
+        eflags[i] |= CH_ENTRY_BULK;     /* the footer names Shift+I and Shift+U on every row */
         if (r->kind == UPKG_ROW_INSTALLED || r->kind == UPKG_ROW_UPGRADE)
             eflags[i] |= CH_ENTRY_INSTALLED | (r->launch && *r->launch ? CH_ENTRY_LAUNCH : 0);
         ents[i].tag = r->name;
@@ -173,9 +175,11 @@ static void box_sink_end(void)
 /* Run the opkg command CMDNAME on TAG. A package with install questions of its own runs in the
