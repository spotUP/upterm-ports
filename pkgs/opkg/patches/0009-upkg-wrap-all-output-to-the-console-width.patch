diff --git a/libopkg/upkg_wrap.c b/libopkg/upkg_wrap.c
new file mode 100644
index 0000000..e0931d9
--- /dev/null
+++ b/libopkg/upkg_wrap.c
@@ -0,0 +1,196 @@
+/* upkg_wrap.c - upkg: output that follows the console width (UP-Term).
+   The size query is the one watch and column use: ioctl(TIOCGWINSZ), which
+   ixemul answers from vtcon (ACTION_VTCON_GWINSZ) or the native console
+   (ACTION_DISK_INFO), then $COLUMNS.
+   SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include "config.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+
+#include "upkg_wrap.h"
+
+#define UPKG_DEFAULT_COLUMNS 76 /* a 640x256 hires Workbench shell */
+#define UPKG_MIN_COLUMNS 20
+
+struct wrap_state {
+    int tty;                    /* -1 unknown, 0 no, 1 yes */
+    int col;                    /* columns already on the current line */
+    int lead;                   /* the current line's own leading blanks */
+    int in_lead;                /* nothing but blanks written on this line */
+};
+
+static struct wrap_state st_out = { -1, 0, 0, 1 };
+static struct wrap_state st_err = { -1, 0, 0, 1 };
+
+static struct wrap_state *state_of(FILE *fp)
+{
+    if (fp == stdout)
+        return &st_out;
+    if (fp == stderr)
+        return &st_err;
+    return NULL;
+}
+
+int upkg_wrap_width(FILE *fp)
+{
+    struct wrap_state *st = state_of(fp);
+    struct winsize ws;
+    const char *e;
+    int fd, cols;
+
+    if (!st)
+        return 0;
+    fd = fileno(fp);
+    if (st->tty < 0)
+        st->tty = fd >= 0 && isatty(fd);
+    if (!st->tty)
+        return 0;
+
+    cols = UPKG_DEFAULT_COLUMNS;
+    if (ioctl(fd, TIOCGWINSZ, &ws) == 0 && ws.ws_col > 0)
+        cols = ws.ws_col;
+    else if ((e = getenv("COLUMNS")) != NULL && atoi(e) > 0)
+        cols = atoi(e);
+    cols--;
+    return cols < UPKG_MIN_COLUMNS ? UPKG_MIN_COLUMNS : cols;
+}
+
+static size_t word_len(const char *s)
+{
+    size_t n = 0;
+    while (s[n] && s[n] != ' ' && s[n] != '\t' && s[n] != '\n')
+        n++;
+    return n;
+}
+
+static void put_blanks(FILE *fp, int n)
+{
+    while (n-- > 0)
+        fputc(' ', fp);
+}
+
+void upkg_wrap_puts(FILE *fp, int hang, const char *s)
+{
+    int w = upkg_wrap_width(fp);
+    struct wrap_state *st = state_of(fp);
+
+    if (!w) {
+        fputs(s, fp);
+        return;
+    }
+    if (hang > w / 2)
+        hang = w / 2;
+
+    while (*s) {
+        int ind = st->lead > hang ? st->lead : hang;
+        if (ind > w / 2)
+            ind = w / 2;
+
+        if (*s == '\n') {
+            fputc('\n', fp);
+            st->col = st->lead = 0;
+            st->in_lead = 1;
+            s++;
+        } else if (*s == ' ' || *s == '\t') {
+            int n = 0, c = st->col;
+            size_t len;
+            while (*s == ' ' || *s == '\t') {
+                int step = *s == '\t' ? 8 - c % 8 : 1;
+                n += step;
+                c += step;
+                s++;
+            }
+            len = word_len(s);
+            if (st->in_lead) {
+                if (n > w / 2)
+                    n = w / 2;
+                put_blanks(fp, n);
+                st->col += n;
+                st->lead = st->col;
+            } else if (st->col + n + (int)len <= w) {
+                put_blanks(fp, n);
+                st->col += n;
+            } else if (len > 0) {
+                /* the next word does not fit: the blanks give way to a break */
+                fputc('\n', fp);
+                put_blanks(fp, ind);
+                st->col = ind;
+            }
+            /* blanks at the end of a line that do not fit are dropped */
+        } else {
+            int len = (int)word_len(s);
+            st->in_lead = 0;
+            if (st->col + len > w && st->col > ind) {
+                fputc('\n', fp);
+                put_blanks(fp, ind);
+                st->col = ind;
+            }
+            while (st->col + len > w) {
+                int room = w - st->col;
+                if (room < 1) {
+                    fputc('\n', fp);
+                    put_blanks(fp, ind);
+                    st->col = ind;
+                    continue;
+                }
+                fwrite(s, 1, room, fp);
+                s += room;
+                len -= room;
+                fputc('\n', fp);
+                put_blanks(fp, ind);
+                st->col = ind;
+            }
+            fwrite(s, 1, len, fp);
+            s += len;
+            st->col += len;
+        }
+    }
+}
+
+int upkg_vfprintf(FILE *fp, int hang, const char *fmt, va_list ap)
+{
+    va_list ap2;
+    char *buf;
+    int n;
+
+    if (!upkg_wrap_width(fp))
+        return vfprintf(fp, fmt, ap);
+
+    va_copy(ap2, ap);
+    n = vsnprintf(NULL, 0, fmt, ap2);
+    va_end(ap2);
+    if (n < 0 || (buf = malloc((size_t)n + 1)) == NULL)
+        return vfprintf(fp, fmt, ap);
+    vsnprintf(buf, (size_t)n + 1, fmt, ap);
+    upkg_wrap_puts(fp, hang, buf);
+    free(buf);
+    return n;
+}
+
+int upkg_fprintf(FILE *fp, const char *fmt, ...)
+{
+    va_list ap;
+    int n;
+
+    va_start(ap, fmt);
+    n = upkg_vfprintf(fp, 2, fmt, ap);
+    va_end(ap);
+    return n;
+}
+
+int upkg_printf(const char *fmt, ...)
+{
+    va_list ap;
+    int n;
+
+    va_start(ap, fmt);
+    n = upkg_vfprintf(stdout, 2, fmt, ap);
+    va_end(ap);
+    return n;
+}
diff --git a/libopkg/upkg_wrap.h b/libopkg/upkg_wrap.h
new file mode 100644
index 0000000..1a34f4f
--- /dev/null
+++ b/libopkg/upkg_wrap.h
@@ -0,0 +1,36 @@
+/* upkg_wrap.h - upkg: output that follows the console width (UP-Term).
+   SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef _UPKG_WRAP_H_
+#define _UPKG_WRAP_H_
+
+#include <stdarg.h>
+#include <stdio.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Usable columns of the console FP is attached to, or 0 when FP is not an
+ * interactive console (a pipe, a file, any stream but stdout and stderr):
+ * then nothing is wrapped and the output is byte for byte what opkg prints.
+ * Order: the console's own size (TIOCGWINSZ), $COLUMNS, 76. One column is
+ * left free so a full line does not wrap twice on a console that wraps at once. */
+int upkg_wrap_width(FILE *fp);
+
+/* Write S (may hold newlines) word-wrapped to the console. A continuation line
+ * is indented by HANG columns or by the line's own leading blanks, whichever is
+ * wider; a word longer than the line breaks hard at the width. */
+void upkg_wrap_puts(FILE *fp, int hang, const char *s);
+
+/* printf into the wrapper; HANG as for upkg_wrap_puts */
+int upkg_vfprintf(FILE *fp, int hang, const char *fmt, va_list ap);
+
+int upkg_fprintf(FILE *fp, const char *fmt, ...)
+    __attribute__ ((format(printf, 2, 3)));
+int upkg_printf(const char *fmt, ...)
+    __attribute__ ((format(printf, 1, 2)));
+
+#ifdef __cplusplus
+}
+#endif
+#endif
