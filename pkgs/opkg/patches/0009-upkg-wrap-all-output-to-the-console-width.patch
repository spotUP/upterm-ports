+/* Help layout. Piped, the text is exactly what patch 0008 printed: options in a column at 30, the
+ * description lines as written. On a console the lines of a description are joined and wrapped to
+ * the window, the column grows with it (18 below 60 columns, 30, 36 from 100). */
+static int help_col(void)
+{
+    int w = upkg_wrap_width(stdout);
+
+    if (!w)
+        return 30;
+    return w < 60 ? 18 : w < 100 ? 30 : 36;
+}
+
+/* S with each newline (and the blanks after it) turned into SEP */
+static char *help_join(const char *s, const char *sep)
+{
+    char *r = xmalloc(strlen(s) * 2 + 1), *p = r;
+
+    while (*s) {
+        if (*s == '\n') {
+            p += sprintf(p, "%s", sep);
+            s++;
+            while (*s == ' ')
+                s++;
+        } else
+            *p++ = *s++;
+    }
+    *p = '\0';
+    return r;
+}
+
+static const char *help_line(const char *s, int n, char *buf, size_t len)
+{
+    const char *e;
+
+    while (n-- > 0 && s) {
+        s = strchr(s, '\n');
+        if (s)
+            s++;
+    }
+    if (!s)
+        return NULL;
+    e = strchr(s, '\n');
+    snprintf(buf, len, "%.*s", e ? (int)(e - s) : (int)strlen(s), s);
+    return buf;
+}
+
+static int help_lines(const char *s)
+{
+    int n = 1;
+
+    for (; s && *s; s++)
+        n += *s == '\n';
+    return n;
+}
+
+static void upkg_help_row(const char *opt, const char *desc)
+{
+    int col = help_col(), joined = upkg_wrap_width(stdout) != 0;
+    char *o = joined ? help_join(opt, ", ") : xstrdup(opt);
+    char *d = desc ? (joined ? help_join(desc, " ") : xstrdup(desc)) : NULL;
+    int no = help_lines(o), nd = d ? help_lines(d) : 0;
+    int own_line = d && no == 1 && (int)strlen(o) > col - 4;
+    int i, n = no > nd ? no : nd;
+    char ob[512], db[512];
+    char *out = xcalloc(1, strlen(o) + (d ? strlen(d) : 0) + (size_t)(no + nd + 1) * (col + 8));
+
+    if (own_line) {
+        sprintf(out, "  %s\n", o);
+        for (i = 0; i < nd; i++)
+            sprintf(out + strlen(out), "%*s%s\n", col, "", help_line(d, i, db, sizeof db));
+    } else {
+        for (i = 0; i < n; i++) {
+            const char *ol = i < no ? help_line(o, i, ob, sizeof ob) : NULL;
+            const char *dl = i < nd ? help_line(d, i, db, sizeof db) : NULL;
+
+            if (ol && dl)
+                sprintf(out + strlen(out), "  %-*s%s\n", col - 2, ol, dl);
+            else if (ol)
+                sprintf(out + strlen(out), "  %s\n", ol);
+            else
+                sprintf(out + strlen(out), "%*s%s\n", col, "", dl);
+        }
+    }
+    upkg_wrap_puts(stdout, col, out);
+    free(out);
+    free(o);
+    free(d);
+}
+
+/* a line nested under a row (the verbosity levels) */
+static void upkg_help_sub(const char *text)
+{
+    char line[256];
+
+    snprintf(line, sizeof line, "%*s%s\n", help_col() + 2, "", text);
+    upkg_wrap_puts(stdout, help_col() + 2, line);
+}
+
+static void upkg_help_text(const char *text)
+{
+    upkg_wrap_puts(stdout, 2, text);
+}
+
+/* running text: piped as written, on a console one paragraph that wraps */
+static void upkg_help_para(const char *text)
+{
+    if (upkg_wrap_width(stdout)) {
+        char *j = help_join(text, " ");
+        upkg_wrap_puts(stdout, 1, j);
+        free(j);
+    } else
+        fputs(text, stdout);
+}
