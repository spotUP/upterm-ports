diff --git a/libopkg/opkg_download_wget.c b/libopkg/opkg_download_wget.c
index 3dec766..d0337e9 100644
--- a/libopkg/opkg_download_wget.c
+++ b/libopkg/opkg_download_wget.c
@@ -5,6 +5,8 @@
    Copyright (C) 2008 OpenMoko Inc
    Copyright (C) 2014 Paul Barker
 
+   Modified 2026-10-19 for upkg (UP-Term): the backend runs curl instead of wget.
+
    SPDX-License-Identifier: GPL-2.0-or-later
 
    This program is free software; you can redistribute it and/or
@@ -20,10 +22,13 @@
 
 #include "config.h"
 
+#include <stdlib.h>
+#include <string.h>
 #include <unistd.h>
 
 #include "opkg_download.h"
 #include "opkg_message.h"
+#include "sprintf_alloc.h"
 #include "xsystem.h"
 
 /* Download using wget backend.
@@ -36,10 +41,32 @@
  * Both the gnu and busybox versions of wget must be supported by this backend,
  * so we are precluded from using most features anyway.
  */
+/* curl is a native AmigaDOS program without ixemul: it does not know that
+ * ixemul reads /UP-Term/x as UP-Term:x. Hand it the AmigaDOS spelling of an
+ * absolute destination: the first component is the volume or assign. */
+static const char *amiga_dest(const char *path, char **buf)
+{
+#ifdef __amigaos__
+    const char *slash;
+    size_t vol;
+
+    if (path[0] != '/' || path[1] == '\0')
+        return path;
+    slash = strchr(path + 1, '/');
+    vol = slash ? (size_t)(slash - path - 1) : strlen(path + 1);
+    sprintf_alloc(buf, "%.*s:%s", (int)vol, path + 1, slash ? slash + 1 : "");
+    return *buf;
+#else
+    (void)buf;
+    return path;
+#endif
+}
+
 int opkg_download_backend(const char *src, const char *dest,
                           curl_progress_func cb, void *data, int use_cache)
 {
     int res;
+    char *adest = NULL;
     const char *argv[8];
     int i = 0;
 
@@ -50,20 +77,21 @@ int opkg_download_backend(const char *src, const char *dest,
 
     unlink(dest);
 
-    argv[i++] = "wget";
-    argv[i++] = "-q";
-    if (opkg_config->http_proxy || opkg_config->ftp_proxy) {
-        argv[i++] = "-Y";
-        argv[i++] = "on";
-    }
-    argv[i++] = "-O";
-    argv[i++] = dest;
+    /* upkg: curl, not wget. -f turns an HTTP error into a non-zero exit, -sS
+     * is silent but keeps the error text, -L follows redirects (GitHub
+     * release assets redirect). The proxy options of the wget backend have
+     * no equivalent here: curl reads http_proxy/https_proxy itself. */
+    argv[i++] = "curl";
+    argv[i++] = "-fsSL";
+    argv[i++] = "-o";
+    argv[i++] = amiga_dest(dest, &adest);
     argv[i++] = src;
     argv[i++] = NULL;
     res = xsystem(argv);
+    free(adest);
 
     if (res) {
-        opkg_msg(ERROR, "Failed to download %s, wget returned %d.\n", src, res);
+        opkg_msg(ERROR, "Failed to download %s, curl returned %d (is curl installed and in PATH?).\n", src, res);
         return -1;
     }
 
