From bc6f9870221d46471c2010639240b5b09920a3d3 Mon Sep 17 00:00:00 2001
From: spotUP <retroranksmail@gmail.com>
Date: Tue, 27 Oct 2026 03:17:21 +0100
Subject: [PATCH 43/50] upkg: an upgrade keeps the answers of the install
 questions and asks only the questions the old version never asked

upkg-ask records each question it asked in info_dir/NAME.answered (upkg passes the path as UPKG_ASK_STATE to the postinst and to the Install All question pass); the upgrade keeps that file when it removes the old package's info files, and no longer runs its scripts unattended, so a question that is new in the upgraded version is asked. UPKG_ASK_UNATTENDED=1 (Install All, a progress box) tells upkg-ask the missing terminal is on purpose.
---
 libopkg/opkg_install.c |  2 +-
 libopkg/opkg_remove.c  |  8 +++++---
 libopkg/opkg_remove.h  |  2 +-
 libopkg/pkg.c          | 24 ++++++++++++++++++++++++
 libopkg/pkg.h          |  1 +
 libopkg/upkg_all.c     |  8 ++++++++
 libopkg/xsystem.c      |  5 +++++
 libopkg/xsystem.h      |  1 +
 src/opkg.c             | 11 +----------
 9 files changed, 47 insertions(+), 15 deletions(-)

diff --git a/libopkg/opkg_install.c b/libopkg/opkg_install.c
index e795099..2860e5b 100644
--- a/libopkg/opkg_install.c
+++ b/libopkg/opkg_install.c
@@ -1052,7 +1052,7 @@ int opkg_install_pkg(pkg_t * pkg, pkg_t * old_pkg)
 
         /* removing files from old package, to avoid ghost files */
         remove_data_files_and_list(old_pkg);
-        remove_maintainer_scripts(old_pkg);
+        remove_maintainer_scripts(old_pkg, 1);
 
         /* maintain the "Auto-Installed: yes" flag */
         pkg->auto_installed = old_pkg->auto_installed;
diff --git a/libopkg/opkg_remove.c b/libopkg/opkg_remove.c
index 5254388..b06383f 100644
--- a/libopkg/opkg_remove.c
+++ b/libopkg/opkg_remove.c
@@ -198,7 +198,8 @@ void remove_data_files_and_list(pkg_t * pkg)
     str_list_deinit(&installed_dirs_symlinks);
 }
 
-void remove_maintainer_scripts(pkg_t * pkg)
+/* KEEP_ANSWERS: leave NAME.answered (the question ids upkg-ask recorded) for the upgrade that replaces the package. */
+void remove_maintainer_scripts(pkg_t * pkg, int keep_answers)
 {
     unsigned int i;
     int err;
@@ -221,7 +222,8 @@ void remove_maintainer_scripts(pkg_t * pkg)
         *lastdot = '\0';
         // Only delete files that match the package name (the glob may match files
         // with similar names)
-        if (!strcmp(filename, pkg->name)) {
+        if (!strcmp(filename, pkg->name) &&
+            !(keep_answers && !strcmp(lastdot + 1, "answered"))) {
             opkg_msg(INFO, "Deleting %s.\n", globbuf.gl_pathv[i]);
             unlink(globbuf.gl_pathv[i]);
         }
@@ -290,7 +292,7 @@ int opkg_remove_pkg(pkg_t * pkg)
 
     err = pkg_run_script(pkg, "postrm", "remove");
 
-    remove_maintainer_scripts(pkg);
+    remove_maintainer_scripts(pkg, 0);
     pkg->state_status = SS_NOT_INSTALLED;
 
     pkg->parent->state_status = SS_NOT_INSTALLED;
diff --git a/libopkg/opkg_remove.h b/libopkg/opkg_remove.h
index b731852..a1c18db 100644
--- a/libopkg/opkg_remove.h
+++ b/libopkg/opkg_remove.h
@@ -30,7 +30,7 @@ extern "C" {
 
 int opkg_remove_pkg(pkg_t * pkg);
 void remove_data_files_and_list(pkg_t * pkg);
-void remove_maintainer_scripts(pkg_t * pkg);
+void remove_maintainer_scripts(pkg_t * pkg, int keep_answers);
 
 #ifdef __cplusplus
 }
diff --git a/libopkg/pkg.c b/libopkg/pkg.c
index 6dac802..670b5e7 100644
--- a/libopkg/pkg.c
+++ b/libopkg/pkg.c
@@ -1332,6 +1332,16 @@ conffile_t *pkg_get_conffile(pkg_t * pkg, const char *file_name)
     return NULL;
 }
 
+/* info_dir/NAME.answered: the question ids upkg-ask recorded as answered for this package (malloc'd). */
+char *pkg_answered_path(pkg_t * pkg)
+{
+    char *path;
+    pkg_dest_t *d = pkg->dest ? pkg->dest : opkg_config->default_dest;
+
+    sprintf_alloc(&path, "%s/%s.answered", d->info_dir, pkg->name);
+    return path;
+}
+
 int pkg_run_script(pkg_t * pkg, const char *script, const char *args)
 {
     int err;
@@ -1377,6 +1387,20 @@ int pkg_run_script(pkg_t * pkg, const char *script, const char *args)
         return 0;
     }
 
+    if (!strcmp(script, "postinst")) {
+        /* upkg-ask keeps the question ids this package's installs answered in info_dir/NAME.answered, so an
+         * upgrade asks only the questions the earlier version never asked. UNATTENDED says the script has
+         * no terminal on purpose (Install All, a progress box): a new question takes its default. */
+        char *state = pkg_answered_path(pkg);
+
+        setenv("UPKG_ASK_STATE", state, 1);
+        free(state);
+        if (upkg_xsystem_is_unattended() || upkg_sink_active())
+            setenv("UPKG_ASK_UNATTENDED", "1", 1);
+        else
+            unsetenv("UPKG_ASK_UNATTENDED");
+    }
+
     sprintf_alloc(&cmd, "%s %s", path, args);
     free(path);
     {
diff --git a/libopkg/pkg.h b/libopkg/pkg.h
index a62c065..016215c 100644
--- a/libopkg/pkg.h
+++ b/libopkg/pkg.h
@@ -213,6 +213,7 @@ file_list_t *pkg_get_installed_files(pkg_t * pkg);
 void pkg_free_installed_files(pkg_t * pkg);
 void pkg_remove_installed_files_list(pkg_t * pkg);
 conffile_t *pkg_get_conffile(pkg_t * pkg, const char *file_name);
+char *pkg_answered_path(pkg_t * pkg);
 int pkg_run_script(pkg_t * pkg, const char *script, const char *args);
 
 /* enum mappings */
diff --git a/libopkg/upkg_all.c b/libopkg/upkg_all.c
index 6561079..14d0dd6 100644
--- a/libopkg/upkg_all.c
+++ b/libopkg/upkg_all.c
@@ -195,7 +195,15 @@ static int ask_one(pkg_t *pkg)
     argv[4] = ans;
     argv[5] = archive;
     argv[6] = NULL;
+    /* the questions asked here are recorded like those of a postinst: an upgrade does not ask them again */
+    {
+        char *state = pkg_answered_path(pkg);
+
+        setenv("UPKG_ASK_STATE", state, 1);
+        free(state);
+    }
     rc = xsystem(argv);
+    unsetenv("UPKG_ASK_STATE");
     answers = rc == 0 ? slurp(ans) : NULL;
     text = slurp(orig);
     unlink(orig);
diff --git a/libopkg/xsystem.c b/libopkg/xsystem.c
index c93ffe2..b9adba7 100644
--- a/libopkg/xsystem.c
+++ b/libopkg/xsystem.c
@@ -45,6 +45,11 @@ void upkg_xsystem_unattended(int on)
     unattended = on;
 }
 
+int upkg_xsystem_is_unattended(void)
+{
+    return unattended;
+}
+
 int xsystem(const char *argv[])
 {
     int status;
diff --git a/libopkg/xsystem.h b/libopkg/xsystem.h
index 382d442..a3081e2 100644
--- a/libopkg/xsystem.h
+++ b/libopkg/xsystem.h
@@ -37,6 +37,7 @@ int xsystem(const char *argv[]);
 
 /* While ON is nonzero the children of xsystem read /dev/null, not the terminal (Install All). */
 void upkg_xsystem_unattended(int on);
+int upkg_xsystem_is_unattended(void);
 
 #ifdef __cplusplus
 }
diff --git a/src/opkg.c b/src/opkg.c
index 2290ec4..e2df789 100644
--- a/src/opkg.c
+++ b/src/opkg.c
@@ -745,17 +745,8 @@ int main(int argc, char *argv[])
         err = upkg_wb((struct WBStartup *)argv);
     else if (all_flag && !strcmp(cmd_name, "install"))
         err = upkg_all_install_cli();
-    else {
-        /* Update All asks no questions: a script of an upgraded package reads nothing from the terminal, so
-         * upkg-ask takes the defaults, and a "<PATH" default is the answer the earlier install kept. */
-        int upgrading = !strcmp(cmd_name, "upgrade");
-
-        if (upgrading)
-            upkg_xsystem_unattended(1);
+    else
         err = opkg_cmd_exec(cmd, argc - opts, (const char **)(argv + opts));
-        if (upgrading)
-            upkg_xsystem_unattended(0);
-    }
 
     opkg_download_cleanup();
  err1:
-- 
