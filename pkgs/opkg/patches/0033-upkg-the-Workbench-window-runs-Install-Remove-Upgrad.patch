+/* Output arrives as text pieces (the sink); the log shows lines. Tabs become spaces to the next multiple of 8, a
+ * carriage return is dropped, a line longer than the buffer is cut. */
+typedef void (*upkg_line_fn)(void *ctx, const char *line);
+typedef struct {
+    char buf[512];
+    size_t n;
+} upkg_lines_t;
+void upkg_lines_put(upkg_lines_t *l, const char *text, size_t len, upkg_line_fn emit, void *ctx);
+void upkg_lines_end(upkg_lines_t *l, upkg_line_fn emit, void *ctx);   /* the unfinished last line, if any */
+
+/* Run the opkg command CMD ("install", "remove", "upgrade") on NAME (NULL for "update", which takes none). The messages of upkg and of
  * its script children go to SINK line by line while it runs (NULL: they stay on stdout). Afterwards
  * the package hash is rebuilt from the feeds and the status files and ROWS is loaded again.
  * Returns the command's exit code, or -1 for an unknown CMD (nothing ran). */
