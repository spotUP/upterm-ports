--- a/libopkg/upkg_wrap.c
+++ b/libopkg/upkg_wrap.c
@@ -12,6 +12,11 @@
 #include <string.h>
 #include <unistd.h>
 #include <sys/ioctl.h>
+#include <sys/time.h>
+#include <sys/types.h>
+#ifdef __amigaos__
+#include <ix.h>
+#endif
 
 #ifdef __amigaos__
 /* The NDK devices/timer.h declares its own struct timeval, which clashes with ixemul's; give the NDK one
@@ -223,6 +228,50 @@ int upkg_sink_active(void)
     return sink != NULL;
 }
 
+static upkg_pump_fn pump;
+static unsigned long pump_mask;
+
+void upkg_set_pump(upkg_pump_fn fn, unsigned long sigmask)
+{
+    pump = fn;
+    pump_mask = fn ? sigmask : 0;
+}
+
+int upkg_pump_active(void)
+{
+    return pump != NULL;
+}
+
+void upkg_pump_call(void)
+{
+    if (pump)
+        pump();
+}
+
+/* One wait on the pipe and the window (ixemul's ix_select takes the signal mask; plain select on a host) */
+int upkg_pump_wait(int fd)
+{
+    fd_set rf;
+    struct timeval tv;
+    int n;
+
+    FD_ZERO(&rf);
+    FD_SET(fd, &rf);
+    tv.tv_sec = 0;
+    tv.tv_usec = 200000;
+#ifdef __amigaos__
+    {
+        unsigned long mask = pump_mask;
+
+        n = ix_select(fd + 1, &rf, NULL, NULL, &tv, &mask);
+    }
+#else
+    n = select(fd + 1, &rf, NULL, NULL, &tv);
+#endif
+    upkg_pump_call();
+    return n < 0 || (n > 0 && FD_ISSET(fd, &rf));
+}
+
 void upkg_sink_write(const char *text, size_t len)
 {
     if (sink)
diff --git a/libopkg/upkg_wrap.h b/libopkg/upkg_wrap.h
index 109f054..0f5129b 100644
--- a/libopkg/upkg_wrap.h
+++ b/libopkg/upkg_wrap.h
@@ -46,6 +46,15 @@ void upkg_wrap_flush(void);
 typedef void (*upkg_sink_fn)(const char *text, size_t len);
 void upkg_set_sink(upkg_sink_fn fn);
 int upkg_sink_active(void);
+
+/* A pump keeps a window alive while upkg waits for a child's output (xsystem): while it is set, xsystem waits
+ * in upkg_pump_wait, which returns when the child's pipe is readable or SIGMASK (the window's signal bit)
+ * arrives, and calls the pump either way. NULL removes it. */
+typedef void (*upkg_pump_fn)(void);
+void upkg_set_pump(upkg_pump_fn fn, unsigned long sigmask);
+int upkg_pump_active(void);
+int upkg_pump_wait(int fd);     /* 1 when FD is readable (or the wait failed: read to find out) */
+void upkg_pump_call(void);
 void upkg_sink_write(const char *text, size_t len);
 
 /* DOS opens a requester (Retry/Cancel) on the Workbench screen when a volume is full or absent, and it takes
diff --git a/libopkg/xsystem.c b/libopkg/xsystem.c
