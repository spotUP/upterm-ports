--- a/libopkg/xsystem.c
+++ b/libopkg/xsystem.c
@@ -88,8 +88,14 @@ int xsystem(const char *argv[])
         ssize_t got;
 
         close(pfd[1]);
-        while ((got = read(pfd[0], chunk, sizeof chunk)) > 0)
+        for (;;) {
+            if (upkg_pump_active() && !upkg_pump_wait(pfd[0]))
+                continue;
+            got = read(pfd[0], chunk, sizeof chunk);
+            if (got <= 0)
+                break;
             upkg_sink_write(chunk, (size_t)got);
+        }
         close(pfd[0]);
     }
 
