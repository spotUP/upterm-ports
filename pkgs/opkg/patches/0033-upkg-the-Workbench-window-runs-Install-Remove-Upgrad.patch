@@ -243,3 +243,43 @@ int upkg_rows_run(upkg_rows_t *rows, const char *cmdname, const char *name, upkg
         upkg_set_sink(NULL);
     return rc;
 }
+
+/* The buttons enabled while a run goes (none: a second run or a quit would meet the first) and otherwise the
+ * ones the row enables, plus Update and Quit. */
+unsigned upkg_rows_buttons(int running, unsigned act)
+{
+    return running ? 0 : (act | UPKG_ACT_UPDATE | UPKG_ACT_QUIT);
+}
+
+void upkg_lines_put(upkg_lines_t *l, const char *text, size_t len, upkg_line_fn emit, void *ctx)
+{
+    size_t i;
+
+    for (i = 0; i < len; i++) {
+        char ch = text[i];
+
+        if (ch == '\n') {
+            l->buf[l->n] = '\0';
+            emit(ctx, l->buf);
+            l->n = 0;
+        } else if (ch == '\r') {
+            continue;
+        } else if (ch == '\t') {
+            do {
+                if (l->n < sizeof l->buf - 1)
+                    l->buf[l->n++] = ' ';
+            } while (l->n % 8 && l->n < sizeof l->buf - 1);
+        } else if (l->n < sizeof l->buf - 1) {
+            l->buf[l->n++] = ch;
+        }
+    }
+}
+
+void upkg_lines_end(upkg_lines_t *l, upkg_line_fn emit, void *ctx)
+{
+    if (l->n) {
+        l->buf[l->n] = '\0';
+        emit(ctx, l->buf);
+        l->n = 0;
+    }
+}
