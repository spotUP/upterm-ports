+
+/* Run the opkg command CMD on the row's package (NAME NULL: Update) with the window live. */
+static void run_cmd(wb_t *wb, const char *cmd, const char *name)
+{
+    char what[320], done[360], *copy = name ? strdup(name) : NULL;
+    int rc;
+
+    snprintf(what, sizeof what, "upkg %s%s%s", cmd, copy ? " " : "", copy ? copy : "");
+    wb->running = 1;
+    buttons_update(wb);
+    log_line(wb, what);
+    cur_wb = wb;
+    memset(&wb->lines, 0, sizeof wb->lines);
+    upkg_set_pump(pump_cb, 1UL << wb->win->UserPort->mp_SigBit);
+    rc = upkg_rows_run(&wb->rows, cmd, copy, sink_cb);
+    upkg_set_pump(NULL, 0);
+    log_hide(wb);
+    upkg_lines_end(&wb->lines, line_emit, wb);
+    snprintf(done, sizeof done, rc == 0 ? "[OK] %s" : "[ERROR] %s (exit %d)", what, rc);
+    log_add(wb, done);
+    log_show(wb);
+    cur_wb = NULL;
+    wb->running = 0;
+    filter_set(wb, wb->filter);         /* the rows were loaded again: show them, no selection */
+    free(copy);
+}
+
+/* A button on the selected row (or Update) */
+static void action(wb_t *wb, int id)
+{
+    const char *cmd = id == G_INSTALL ? "install" : id == G_REMOVE ? "remove" : id == G_UPGRADE ? "upgrade" : "update";
+    const char *name = NULL;
+
+    if (id != G_UPDATE) {
+        if (wb->sel < 0)
+            return;
+        name = wb->rows.row[wb->idx[wb->sel]].name;
+    }
+    run_cmd(wb, cmd, name);
+}
+
+/* All waiting messages. While a command runs, closing the window is refused with a requester. */
+static void drain(wb_t *wb, int *quit)
+{
+    struct IntuiMessage *msg;
+
+    while ((msg = GT_GetIMsg(wb->win->UserPort)) != NULL) {
+        ULONG cls = msg->Class;
+        UWORD code = msg->Code;
+        struct Gadget *gad = (struct Gadget *)msg->IAddress;
+
+        GT_ReplyIMsg(msg);
+        switch (cls) {
+        case IDCMP_CLOSEWINDOW:
+            if (wb->running)
+                say_requester(wb, "A command is still running.\nThe window closes when it is done.");
+            else
+                *quit = 1;
+            break;
+        case IDCMP_REFRESHWINDOW:
+            GT_BeginRefresh(wb->win);
+            GT_EndRefresh(wb->win, TRUE);
+            break;
+        case IDCMP_GADGETUP:
+            if (wb->running)
                 break;
-            }
+            if (gad->GadgetID == G_QUIT)
+                *quit = 1;
+            else if (gad->GadgetID == G_FILTER)
+                filter_set(wb, (upkg_filter_t)code);
+            else if (gad->GadgetID == G_LIST) {
+                wb->sel = (long)code < (long)wb->shown ? (long)code : -1;
+                buttons_update(wb);
+            } else if (gad->GadgetID >= G_INSTALL && gad->GadgetID <= G_UPDATE)
+                action(wb, gad->GadgetID);
+            break;
         }
     }
+}
+
+static int event_loop(wb_t *wb)
+{
+    int quit = 0;
+
+    while (!quit) {
+        Wait(1UL << wb->win->UserPort->mp_SigBit);
+        drain(wb, &quit);
+    }
     return 0;
 }
 
diff --git a/libopkg/upkg_wrap.c b/libopkg/upkg_wrap.c
