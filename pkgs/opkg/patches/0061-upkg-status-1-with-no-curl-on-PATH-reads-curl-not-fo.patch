From 407c14a99e287ec4c5dfceea066009a18726ffce Mon Sep 17 00:00:00 2001
From: spotUP <retroranksmail@gmail.com>
Date: Sun, 1 Nov 2026 02:53:56 +0100
Subject: [PATCH 61/61] upkg: status -1 with no curl on PATH reads curl not
 found

On the Amiga a missing curl makes xsystem return -1 (not 127/255), so since patch 0058
the "curl not found (is curl installed and in PATH?)" text never showed. On -1
upkg_curl_fail_text now probes PATH for curl (the lookup execvp makes): absent gives
the PATH hint, present keeps "curl did not finish". Host check: check/curl_msg.sh.
---
 libopkg/opkg_download_wget.c | 35 ++++++++++++++++++++++++++++++-----
 1 file changed, 30 insertions(+), 5 deletions(-)

diff --git a/libopkg/opkg_download_wget.c b/libopkg/opkg_download_wget.c
index 8b29c80..d1e63f4 100644
--- a/libopkg/opkg_download_wget.c
+++ b/libopkg/opkg_download_wget.c
@@ -88,11 +88,33 @@ static int dest_name_too_long(const char *path)
 }
 #endif
 
-/* upkg: what a curl exit status means, for the download error text. Pure:
- * no I/O, so the host check can drive it with a fake curl. 127 is the shell's
+/* upkg: is an executable `name` in a directory of PATH? The lookup execvp makes in xsystem's child (same PATH, ':' separated). */
+static int upkg_on_path(const char *name)
+{
+    const char *p = getenv("PATH");
+    char cand[1024];
+
+    while (p && *p) {
+        size_t n = strcspn(p, ":");
+        if (n && n + 1 + strlen(name) < sizeof cand) {
+            memcpy(cand, p, n);
+            snprintf(cand + n, sizeof cand - n, "/%s", name);
+            if (access(cand, X_OK) == 0)
+                return 1;
+        }
+        p += n;
+        if (*p == ':')
+            p++;
+    }
+    return 0;
+}
+
+/* upkg: what a curl exit status means, for the download error text. Reads PATH only
+ * (for -1), so the host check can drive it with a fake curl. 127 is the shell's
  * "command not found", 255 is xsystem's child after a failed execvp
- * (_exit(-1)); only these keep the PATH hint. -1 is xsystem's own failure: a
- * child killed by a signal (Ctrl-C), a failed fork or wait; xsystem names it on its own line. The text is a clause that follows "Failed to download X, ". */
+ * (_exit(-1)); these keep the PATH hint. -1 is xsystem's own failure: a child killed by a signal
+ * (Ctrl-C), a failed fork or wait, and on the Amiga also a curl that is not there; it reads "did not finish"
+ * only when curl is on PATH (upkg_on_path), else it is "curl not found". The text is a clause that follows "Failed to download X, ". */
 const char *upkg_curl_fail_text(int res, char *buf, size_t len)
 {
     switch (res) {
@@ -102,7 +124,10 @@ const char *upkg_curl_fail_text(int res, char *buf, size_t len)
     case 28: return "timed out";
     case 127:
     case 255: return "curl not found (is curl installed and in PATH?)";
-    case -1: return "curl did not finish (killed by a signal, or it could not be started)";
+    case -1:
+        if (!upkg_on_path("curl"))
+            return "curl not found (is curl installed and in PATH?)";
+        return "curl did not finish (killed by a signal, or it could not be started)";
     }
     snprintf(buf, len, "curl returned %d", res);
     return buf;
