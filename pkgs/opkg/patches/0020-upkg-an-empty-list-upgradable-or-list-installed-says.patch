From 06e070c9a36789f120cc8672dd06d61e2b7d3cac Mon Sep 17 00:00:00 2001
From: spotUP <retroranksmail@gmail.com>
Date: Wed, 21 Oct 2026 16:12:29 +0200
Subject: [PATCH 20/21] upkg: an empty list-upgradable or list-installed says
 so on a terminal

When stdout is a terminal, list-upgradable prints 'All installed add-ons are up to date.' and list-installed prints 'No add-ons are installed.', exit 0. Through a pipe the output stays empty.
---
 libopkg/opkg_cmd.c                     | 4 ++++
 libopkg/solvers/internal/opkg_action.c | 7 +++++++
 2 files changed, 11 insertions(+)

diff --git a/libopkg/opkg_cmd.c b/libopkg/opkg_cmd.c
index 30ccd51..449eae5 100644
--- a/libopkg/opkg_cmd.c
+++ b/libopkg/opkg_cmd.c
@@ -678,6 +678,10 @@ static int opkg_list_installed_cmd(int argc, char **argv)
         return 1;
     }
 
+    /* upkg: on a terminal an empty list says so; a pipe or $(...) still gets nothing */
+    if (!pkg_name && !shown && isatty(1))
+        printf("No add-ons are installed.\n");
+
     return 0;
 }
 
diff --git a/libopkg/solvers/internal/opkg_action.c b/libopkg/solvers/internal/opkg_action.c
index 889d7c3..d0e1e93 100644
--- a/libopkg/solvers/internal/opkg_action.c
+++ b/libopkg/solvers/internal/opkg_action.c
@@ -17,6 +17,7 @@
 */
 
 #include "config.h"
+#include <unistd.h>
 #include "opkg_install_internal.h"
 #include "opkg_solver_internal.h"
 
@@ -248,6 +249,7 @@ int opkg_solver_upgrade(int num_pkgs, char **pkg_names)
 
 int opkg_solver_list_upgradable(int num_pkgs, char **pkg_names) {
     pkg_t *_old_pkg, *_new_pkg;
+    unsigned int shown = 0;
     LIST_HEAD(head);
 
     prepare_upgrade_list(&head);
@@ -263,7 +265,12 @@ int opkg_solver_list_upgradable(int num_pkgs, char **pkg_names) {
         printf("%s - %s - %s\n", _old_pkg->name, old_v, new_v);
         free(old_v);
         free(new_v);
+        shown++;
     }
+    /* upkg: on a terminal an empty answer says so; a pipe or $(...) still gets nothing
+     * (dist/upkg-browse reads this list that way). */
+    if (!shown && isatty(1))
+        printf("All installed add-ons are up to date.\n");
     return 0;
 }
 
