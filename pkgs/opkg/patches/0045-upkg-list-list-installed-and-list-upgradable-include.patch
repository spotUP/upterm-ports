+/* The launch command of the package NAME whose script is SCRIPT (malloc, "" for none): the program the script copies
+ * into ${UHC/EXTBIN}. Of the programs copied there the one named like the package (case-insensitive) wins, else the
+ * first. Read from the same file list upkg_uhc_files makes for remove (one Copy-line parser), so an ExtBin that
+ * ENV:UHC/EXTBIN does not name (the variable is unset), or a script with no Copy into it, gives "". */
+char *upkg_uhc_launch(const char *script, const char *name)
+{
+    char **files = NULL, *dir, *found = NULL;
+    size_t n, i, dl;
+    int dummy;
+
+    dir = expand("${UHC/EXTBIN}", &dummy);
+    if (!dir)
+        return xstrdup("");
+    dl = strlen(dir);
+    if (dl && dir[dl - 1] != '/' && dir[dl - 1] != ':')
+        dir[dl++] = '/', dir[dl] = '\0';
+    n = upkg_uhc_files(script, &files, NULL);
+    for (i = 0; i < n; i++) {
+        const char *base = base_of(files[i]);
+
+        if (strncasecmp(files[i], dir, dl) || !*base || base != files[i] + dl)
+            continue;               /* not a program copied straight into ExtBin */
+        if (!strcasecmp(base, name)) {
+            free(found);
+            found = xstrdup(files[i]);
+            break;
+        }
+        if (!found)
+            found = xstrdup(files[i]);
+    }
+    upkg_uhc_files_free(files, n);
+    free(dir);
+    return found ? found : xstrdup("");
+}
