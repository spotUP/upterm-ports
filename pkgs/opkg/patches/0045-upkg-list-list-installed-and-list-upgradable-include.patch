-static int upkg_list_find(FILE *out, int argc, char **argv, int use_desc, int only_new)
+
+/* UP-Term (upkg): the UHC catalogue rows in the CLI lists, and the --tsv form of the three lists.
+ * WHICH names the list: UPKG_LIST_ALL (list), UPKG_LIST_INSTALLED, UPKG_LIST_UPGRADABLE; UPKG_LIST_NONE is for the
+ * callers that must not see UHC rows (upkg_browse_list: upkg_rows_load appends them itself) and never prints --tsv. */
+enum { UPKG_LIST_NONE = -1, UPKG_LIST_ALL, UPKG_LIST_INSTALLED, UPKG_LIST_UPGRADABLE };
+
+/* the --tsv field: S with tab, CR and LF replaced by a space (malloc) */
+static char *upkg_tsv_field(const char *s)
+{
+    char *d = xstrdup(s ? s : ""), *p;
+
+    for (p = d; *p; p++)
+        if (*p == '\t' || *p == '\r' || *p == '\n')
+            *p = ' ';
+    return d;
+}
+
+/* One --tsv row. Column order is fixed (documented in `upkg --help` and pkgs/opkg/doc/upkg-tsv.txt):
+ * name, version, installed, upgradable, size, section, launch, src, description. */
+static void upkg_tsv_row(FILE *out, const char *name, const char *version, int installed, int upgradable,
+                         const char *size, const char *section, const char *launch, const char *src,
+                         const char *desc)
+{
+    const char *f[9];
+    char *c[9], num[2][2] = { { '0' + !!installed, 0 }, { '0' + !!upgradable, 0 } };
+    int i;
+
+    f[0] = name; f[1] = version; f[2] = num[0]; f[3] = num[1]; f[4] = size; f[5] = section;
+    f[6] = launch; f[7] = src; f[8] = desc;
+    for (i = 0; i < 9; i++) {
+        c[i] = upkg_tsv_field(f[i]);
+        fprintf(out, "%s%s", i ? "\t" : "", c[i]);
+        free(c[i]);
+    }
+    fputc('\n', out);
+}
+
+/* the "uhc:" part of GLOB is dropped: a glob names the bare package */
+static int upkg_uhc_glob_match(const char *glob, const char *name)
+{
+    const char *g = glob ? (upkg_uhc_name(glob) ? upkg_uhc_name(glob) : glob) : NULL;
+
+    return !g || !fnmatch(g, name, 0);
+}
+
+/* the UHC packages that belong in list WHICH, as text rows "uhc:NAME - VERSION - DESC" (the name is the argument
+ * `upkg install` takes for it) or, with --tsv, as tsv rows; returns how many matched GLOB */
+static unsigned int upkg_uhc_print(FILE *out, int which, const char *glob)
+{
+    upkg_uhc_t u = { 0 };
+    unsigned int shown = 0;
+    size_t i;
+
+    upkg_uhc_read(&u, upkg_uhc_dir());
+    for (i = 0; i < u.n; i++) {
+        const upkg_uhc_pkg_t *p = &u.pkg[i];
+        int inst = *p->installed != '\0', upg = inst && strcmp(p->installed, p->version);
+        const char *ver = which == UPKG_LIST_INSTALLED ? p->installed : p->version;
+
+        if ((which == UPKG_LIST_INSTALLED && !inst) || (which == UPKG_LIST_UPGRADABLE && !upg))
+            continue;
+        if (!upkg_uhc_glob_match(glob, p->name))
+            continue;
+        if (opkg_config->tsv) {
+            char *script = upkg_uhc_script_path(upkg_uhc_dir(), p->name), *launch = upkg_uhc_launch(script, p->name);
+
+            upkg_tsv_row(out, p->name, ver, inst, upg, "", "", launch, "uhc", p->desc);
+            free(launch);
+            free(script);
+        } else if (which == UPKG_LIST_UPGRADABLE) {
+            fprintf(out, UPKG_UHC_PREFIX "%s - %s - %s\n", p->name, p->installed, p->version);
+        } else if (*p->desc) {
+            fprintf(out, UPKG_UHC_PREFIX "%s - %s - %s\n", p->name, ver, p->desc);
+        } else {
+            fprintf(out, UPKG_UHC_PREFIX "%s - %s\n", p->name, ver);
+        }
+        shown++;
+    }
+    upkg_uhc_free(&u);
+    return shown;
+}
+
+/* `upkg list|list-installed|list-upgradable --tsv [glob]`: one load of the package hash (and the drawer), one row
+ * per package, the feed rows then the UHC rows. */
+static int upkg_list_tsv(FILE *out, int which, int argc, char **argv)
+{
+    const char *glob = argc > 0 ? argv[0] : NULL;
+    unsigned int i, shown = 0;
+    char *upg = NULL;
+    size_t usize = 0;
+    pkg_vec_t *vec = pkg_vec_alloc();
+    FILE *fp = open_memstream(&upg, &usize);
+
+    if (fp) {
+        opkg_solver_list_upgradable(fp, 0, NULL);
+        fclose(fp);
+    }
+    if (which == UPKG_LIST_INSTALLED)
+        pkg_hash_fetch_all_installed(vec, INSTALLED);
+    else
+        pkg_hash_fetch_available(vec);
+    pkg_vec_sort(vec, pkg_compare_names);
+    for (i = 0; i < vec->len; i++) {
+        pkg_t *pkg = vec->pkgs[i];
+        size_t nl = strlen(pkg->name), ul = 0;
+        const char *ul_text = upg ? upkg_rows_find_name(upg, pkg->name, nl, &ul) : NULL;
+        const char *new_sep = NULL;
+        int installed, upgradable = ul_text != NULL;
+        char *ver, *size = NULL, *launch = NULL;
+
+        if (glob && fnmatch(glob, pkg->name, 0))
+            continue;
+        installed = which == UPKG_LIST_INSTALLED || pkg_hash_fetch_installed_by_name(pkg->name) != NULL;
+        ver = pkg_version_str_alloc(pkg);
+        if (which == UPKG_LIST_UPGRADABLE) {
+            /* the line is "NAME - INSTALLED - NEW": only the newest candidate is a row */
+            if (!ul_text)
+                goto next;
+            new_sep = strstr(ul_text, " - ");
+            if (!new_sep || strncmp(new_sep + 3, ver, ul - (size_t)(new_sep + 3 - ul_text))
+                || strlen(ver) != ul - (size_t)(new_sep + 3 - ul_text))
+                goto next;
+        }
+        sprintf_alloc(&size, "%lu", pkg->state_status == SS_INSTALLED || pkg->state_status == SS_UNPACKED
+                                      ? pkg->installed_size : pkg->size);
+        launch = installed ? upkg_rows_launch(pkg->name) : upkg_rows_feed_launch(pkg->name);
+        upkg_tsv_row(out, pkg->name, ver, installed, upgradable, size, pkg->section, launch, "upkg",
+                     pkg->description);
+        shown++;
+next:
+        free(ver);
+        free(size);
+        free(launch);
+    }
+    pkg_vec_free(vec);
+    free(upg);
+    upkg_uhc_print(out, which, glob);
+    (void) shown;
+    return 0;
+}
+
