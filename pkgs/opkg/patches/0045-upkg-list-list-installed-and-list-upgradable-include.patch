+/* true when a feed's control for NAME has "UP-Term-Interactive: yes" (the package asks questions of its own) */
+int upkg_rows_interactive(const char *name)
+{
+    char *v;
+    int yes;
+
+    if (upkg_uhc_name(name))
+        return 0;       /* a UHC script asks nothing here: the feeds say nothing about it */
+    v = feed_field(name, "UP-Term-Interactive");
+    yes = v && !strcmp(v, "yes");
+    free(v);
+    return yes;
+}
