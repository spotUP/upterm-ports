+/* UP-Term (upkg): `upkg info uhc:NAME`, the catalogue entry in the layout of an ipk info block; 1 when no such
+ * package is in the drawer (D3: a bare NAME is the ipk) */
+static int upkg_uhc_info(const char *name)
+{
+    upkg_uhc_t u = { 0 };
+    size_t i;
+    int err = 1;
+
+    upkg_uhc_read(&u, upkg_uhc_dir());
+    for (i = 0; i < u.n; i++) {
+        const upkg_uhc_pkg_t *p = &u.pkg[i];
+
+        if (strcmp(p->name, name))
+            continue;
+        printf("Package: %s%s\nVersion: %s\nStatus: %s\nSource: uhc\n", UPKG_UHC_PREFIX, p->name, p->version,
+               !*p->installed ? "not installed" : strcmp(p->installed, p->version) ? "installed (older)" : "installed");
+        if (*p->installed)
+            printf("Installed-Version: %s\n", p->installed);
+        if (*p->desc)
+            printf("Description: %s\n", p->desc);
+        printf("\n");
+        err = 0;
+    }
+    upkg_uhc_free(&u);
+    if (err)
+        fprintf(stderr, "upkg: no UHC package \"%s\"\n", name);
+    return err;
 }
 
