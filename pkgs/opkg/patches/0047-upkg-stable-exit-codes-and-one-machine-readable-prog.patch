+/* --- exit class and progress lines (doc/upkg-api.txt) --- */
+
+int upkg_fail_class;
+static int prog_n, prog_m;
+
+void upkg_note_fail(int cls)
+{
+    if (!upkg_fail_class)
+        upkg_fail_class = cls;
+}
+
+void upkg_progress_plan(int m)
+{
+    prog_n = 0;
+    prog_m = m;
+}
+
+void upkg_progress_next(void)
+{
+    prog_n++;
+}
+
+void upkg_progress(const char *phase, const char *name)
+{
+    const char *e = getenv("UPKG_PROGRESS");
+
+    if (isatty(1) && !(e && *e == '1'))
+        return;
+    opkg_msg(NOTICE, "[PROGRESS %d/%d] %s %s\n", prog_n, prog_m, phase, name);
+}
