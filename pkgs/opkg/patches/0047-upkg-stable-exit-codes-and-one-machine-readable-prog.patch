diff --git a/libopkg/opkg_cmd.h b/libopkg/opkg_cmd.h
index 0ba3b95..efd34ac 100644
--- a/libopkg/opkg_cmd.h
+++ b/libopkg/opkg_cmd.h
@@ -41,16 +41,38 @@ typedef struct opkg_cmd opkg_cmd_t;
 opkg_cmd_t *opkg_cmd_find(const char *name);
 int opkg_cmd_exec(opkg_cmd_t * cmd, int argc, const char **argv);
 
-/* AmigaOS RETURN_FAIL */
-#define UPKG_RC_FAIL 20
+/* upkg exit codes (doc/upkg-api.txt). The bands are the AmigaDOS ones a script tests with If WARN / ERROR / FAIL:
+ * 5 is WARN, 10 up to 19 are ERROR, 20 is FAIL. */
+#define UPKG_RC_OK 0
+#define UPKG_RC_NOTHING 5      /* WARN: the command matched nothing or had nothing to do */
+#define UPKG_RC_ERROR 10       /* ERROR: a command failed for a reason with no code of its own */
+#define UPKG_RC_USAGE 11       /* ERROR: bad command, option or arguments; no terminal for browse */
+#define UPKG_RC_NOTFOUND 12    /* ERROR: no package of that name in the feeds */
+#define UPKG_RC_NETWORK 13     /* ERROR: a download failed */
+#define UPKG_RC_SCRIPT 14      /* ERROR: a package script (preinst, postinst, prerm, postrm, UHC script) failed */
+#define UPKG_RC_ANSWERS 15     /* ERROR: the package asks questions and there is no terminal to ask on */
+#define UPKG_RC_FAIL 20        /* FAIL: start-up failed, or the failure has no class (never a negative code) */
+
+/* The first failure class a command notes (UPKG_RC_NOTFOUND ... UPKG_RC_ANSWERS); upkg_rc turns the -1 the
+ * command returns into it. Later notes do not replace the first: it is the cause, the rest follow from it. */
+extern int upkg_fail_class;
+void upkg_note_fail(int cls);
+
+/* Machine-readable progress, `[PROGRESS n/m] phase name` (doc/upkg-api.txt): printed when stdout is not a
+ * terminal, or UPKG_PROGRESS=1. upkg_progress_plan(m) starts a run of m steps, upkg_progress_next() counts the
+ * next step, upkg_progress prints the line for the current step. Goes through opkg_msg(NOTICE), the path of
+ * every other progress line. */
+void upkg_progress_plan(int m);
+void upkg_progress_next(void);
+void upkg_progress(const char *phase, const char *name);
 
 /* The code upkg reports for a command result: a failure is RETURN_FAIL (20), never the -1 several commands
  * return (the AmigaOS Shell reads a negative code as "Unknown command"); success 0 and the positive codes a
- * command returns itself (1: nothing matched) stay. One mapping for the Shell exit, browse and the Workbench
+ * command returns itself (UPKG_RC_NOTHING: nothing matched) stay. One mapping for the Shell exit, browse and the Workbench
  * window, so all three show the same code. */
 static inline int upkg_rc(int err)
 {
-    return err < 0 ? UPKG_RC_FAIL : err;
+    return err < 0 ? (upkg_fail_class ? upkg_fail_class : UPKG_RC_FAIL) : err;
 }
 
 extern int opkg_state_changed;
