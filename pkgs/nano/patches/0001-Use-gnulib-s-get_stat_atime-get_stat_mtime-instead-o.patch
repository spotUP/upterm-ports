From d96d12b8ee25b773a6fb308fdec9f5782d39da3c Mon Sep 17 00:00:00 2001
From: upterm-ports <upterm-ports@localhost>
Date: Thu, 8 Oct 2026 17:16:53 +0200
Subject: [PATCH] Use gnulib's get_stat_atime/get_stat_mtime instead of
 st_atim/st_mtim

POSIX.1-2008 struct stat members that ixemul's struct stat has not (its
nanosecond slots carry AmigaDOS data). gnulib's stat-time.h, already in
nano's lib/, reads what the platform has.
---
 src/files.c |  6 ++++--
 src/text.c  | 10 ++++++----
 2 files changed, 10 insertions(+), 6 deletions(-)

diff --git a/src/files.c b/src/files.c
index 3f71c59..fb71197 100644
--- a/src/files.c
+++ b/src/files.c
@@ -21,6 +21,8 @@
 
 #include "prototypes.h"
 
+#include "stat-time.h"
+
 #include <errno.h>
 #include <fcntl.h>
 #include <libgen.h>
@@ -1656,8 +1658,8 @@ bool make_backup_of(char *realname, struct stat fileinfo)
 
 	/* Set the backup's timestamps to those of the original file.
 	 * Failure is unimportant: saving the file apparently worked. */
-	filetimes[0] = fileinfo.st_atim;
-	filetimes[1] = fileinfo.st_mtim;
+	filetimes[0] = get_stat_atime(&fileinfo);
+	filetimes[1] = get_stat_mtime(&fileinfo);
 	IGNORE_CALL_RESULT(futimens(descriptor, filetimes));
 
 	if (fclose(backup_file) == 0) {
diff --git a/src/text.c b/src/text.c
index b96c3e6..c24d455 100644
--- a/src/text.c
+++ b/src/text.c
@@ -25,6 +25,8 @@
 
 #include "prototypes.h"
 
+#include "stat-time.h"
+
 #include <errno.h>
 #include <fcntl.h>
 #include <string.h>
@@ -2135,8 +2137,8 @@ void treat(char *tempfile_name, char *theprogram, bool spelling)
 			return;
 		}
 
-		timestamp_sec = (long)fileinfo.st_mtim.tv_sec;
-		timestamp_nsec = (long)fileinfo.st_mtim.tv_nsec;
+		timestamp_sec = (long)get_stat_mtime(&fileinfo).tv_sec;
+		timestamp_nsec = (long)get_stat_mtime(&fileinfo).tv_nsec;
 	}
 
 	/* The spell checker needs the screen, so exit from curses mode. */
@@ -2190,8 +2192,8 @@ void treat(char *tempfile_name, char *theprogram, bool spelling)
 
 	/* When the temporary file wasn't touched, say so and leave. */
 	if (timestamp_sec > 0 && stat(tempfile_name, &fileinfo) == 0 &&
-					(long)fileinfo.st_mtim.tv_sec == timestamp_sec &&
-					(long)fileinfo.st_mtim.tv_nsec == timestamp_nsec) {
+					(long)get_stat_mtime(&fileinfo).tv_sec == timestamp_sec &&
+					(long)get_stat_mtime(&fileinfo).tv_nsec == timestamp_nsec) {
 		statusline(REMARK, _("Nothing changed"));
 		return;
 	}
-- 
